---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Veterinaria Huellitas | Cuidado Profesional con Amor para tu Mascota"
  description="Clínica veterinaria líder en salud animal: medicina preventiva, cirugías, urgencias 24/7 y peluquería en Santiago."
>
  <!-- Sección Hero / Bienvenida Preliminar -->
  <section class="relative overflow-hidden bg-gradient-to-b from-teal-50/60 to-white py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-teal-100 px-3.5 py-1 text-sm font-semibold text-teal-800 shadow-xs">
        <span class="flex h-2 w-2 rounded-full bg-teal-500"></span>
        Atención Veterinaria Personalizada & Urgencias 24/7
      </div>

      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Cuidado profesional con amor <br class="hidden sm:inline" />
        <span class="text-teal-600">para tu mejor amigo</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 leading-relaxed">
        En Huellitas cuidamos la salud y felicidad de tus mascotas con tecnología de vanguardia,
        médicos veterinarios dedicados y un trato cálido como de familia.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="#contacto"
          class="inline-flex items-center justify-center rounded-lg bg-teal-600 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-2"
        >
          Agendar una Consulta
        </a>
        <a
          href="#servicios"
          class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-700 shadow-xs transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-2"
        >
          Ver Servicios
        </a>
      </div>
    </div>
  </section>

  <!-- Marcador de Sección: Servicios -->
  <section id="servicios" class="border-t border-slate-200/80 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-xs font-bold tracking-widest text-teal-600 uppercase">
        Especialidades Médicas
      </h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Nuestros Servicios Clínicos
      </p>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600 text-sm">
        (Los componentes detallados de cada servicio se implementarán en la Fase 3)
      </p>
    </div>
  </section>

  <!-- Marcador de Sección: Nosotros -->
  <section id="nosotros" class="border-t border-slate-200/80 bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-xs font-bold tracking-widest text-teal-600 uppercase">
        Equipo Especializado
      </h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Conoce a Nuestro Equipo
      </p>
    </div>
  </section>

  <!-- Marcador de Sección: Testimonios -->
  <section id="testimonios" class="border-t border-slate-200/80 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-xs font-bold tracking-widest text-teal-600 uppercase">Testimonios</h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Familias que Confían en Nosotros
      </p>
    </div>
  </section>

  <!-- Marcador de Sección: Horarios -->
  <section id="horarios" class="border-t border-slate-200/80 bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-xs font-bold tracking-widest text-teal-600 uppercase">
        Horarios de Atención
      </h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Lunes a Domingo + Urgencias 24/7
      </p>
    </div>
  </section>

  <!-- Marcador de Sección: Contacto -->
  <section id="contacto" class="border-t border-slate-200/80 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-xs font-bold tracking-widest text-teal-600 uppercase">Agenda tu Cita</h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Ponte en Contacto con la Clínica
      </p>
    </div>
  </section>
</Layout>
