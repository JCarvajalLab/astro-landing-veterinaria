---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Veterinaria Huellitas | Cuidado Integral para tu Mascota">
  <main class="mx-auto max-w-4xl px-4 py-16 text-center">
    <span class="inline-block rounded-full bg-teal-100 px-3 py-1 text-sm font-semibold text-teal-800">
      Clínica Veterinaria & Spa
    </span>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
      Cuidado profesional con amor para tu mascota
    </h1>
    <p class="mt-4 text-lg text-slate-600">
      Consultas, cirugías, vacunación, peluquería canina y urgencias 24/7.
    </p>
  </main>
</Layout>
