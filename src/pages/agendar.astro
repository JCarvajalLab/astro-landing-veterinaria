              </div>
            </div>

            <div>
              <label
                for="b-notes"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider dark:text-slate-300"
              >
                Motivo o Síntomas Observados
              </label>
              <textarea
                id="b-notes"
                rows="3"
                maxlength="800"
                placeholder="Indícanos si viene por control preventivo, decaimiento, vómitos, cojera, vacuna anual, corte de pelo, etc."
                class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:focus:border-teal-400"
              ></textarea>
            </div>

            <div
              id="booking-feedback"
              class="hidden rounded-xl p-3 text-sm font-medium"
              role="status"
              aria-live="polite"
            ></div>

            <div class="mt-6 flex justify-end">
              <button
                type="submit"
                id="btn-confirm-booking"
                class="inline-flex items-center gap-2 rounded-xl bg-teal-600 px-8 py-3.5 text-base font-bold text-white shadow-md transition hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600 active:scale-98 disabled:opacity-60 dark:bg-teal-500 dark:text-slate-950 dark:hover:bg-teal-400"
              >
                <span id="btn-booking-text">Confirmar mi Reserva de Cita</span>
                <svg
                  id="btn-booking-spinner"
                  class="ml-2 hidden h-5 w-5 animate-spin text-white dark:text-slate-950"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"
                  ></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
              </button>
            </div>
          </form>
        </section>

        <!-- ========================================== -->
        <!-- PASO 4: COMPROBANTE CON CÓDIGO QR Y PRINT-ONLY -->
        <!-- ========================================== -->
        <section
          id="step-4"
          class="step-container hidden rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-10 text-center dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="no-print mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-emerald-100 text-emerald-600 shadow-md dark:bg-emerald-950/70 dark:text-emerald-300">
            <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"
              />
            </svg>
          </div>

          <span class="no-print mt-5 inline-block rounded-full bg-emerald-50 px-3.5 py-1 text-xs font-bold text-emerald-800 uppercase tracking-wider dark:bg-emerald-950/70 dark:text-emerald-300">
            ¡Reserva Confirmada con Éxito!
          </span>

          <h2 class="no-print mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl dark:text-white">
            La cita de tu mascota ha sido agendada
          </h2>
          <p class="no-print mt-2 text-sm text-slate-600 max-w-lg mx-auto dark:text-slate-400">
            Hemos registrado tu hora médica y enviado el comprobante a tu correo y WhatsApp.
          </p>

          <!-- Tarjeta de Comprobante Oficial Imprimible Exclusiva (#printable-receipt) -->
          <div
            id="printable-receipt"
            class="mt-8 mx-auto max-w-xl rounded-3xl border-2 border-teal-600 bg-white p-6 sm:p-8 text-left shadow-lg text-slate-900 dark:border-teal-500 dark:bg-slate-900/90 dark:text-slate-100"
          >
            <!-- Cabecera del comprobante con Logo -->
            <div class="flex items-center justify-between border-b-2 border-teal-600 pb-4 dark:border-teal-500">
              <div class="flex items-center gap-2 text-lg font-black text-slate-900 dark:text-white">
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-teal-600 text-white">
                  🐾
                </span>
                <span>Clínica Veterinaria Huellitas</span>
              </div>
              <div class="text-right">
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block dark:text-slate-400">
                  Código de Reserva
                </span>
                <span
                  id="res-code"
                  class="font-mono text-base font-black text-teal-700 dark:text-teal-400"
                >
                  #HUE-2026-8942
                </span>
              </div>
            </div>

            <!-- Cuerpo con datos médicos y Código QR en 2 columnas -->
            <div class="mt-6 grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
              <!-- Datos de la Cita (8 cols) -->
              <dl class="sm:col-span-8 space-y-3 text-xs">
                <div>
                  <dt class="font-semibold text-slate-500 uppercase tracking-wider text-[10px] dark:text-slate-400">
                    Paciente / Mascota:
                  </dt>
                  <dd id="res-pet" class="font-bold text-slate-900 text-sm mt-0.5 dark:text-white">
                    Simón (Perro)
                  </dd>
                </div>
                <div>
                  <dt class="font-semibold text-slate-500 uppercase tracking-wider text-[10px] dark:text-slate-400">
                    Tutor Responsable:
                  </dt>
                  <dd
                    id="res-owner"
                    class="font-bold text-slate-900 text-sm mt-0.5 dark:text-white"
                  >
                    Marcela Contreras (+56 9 8765 4321)
                  </dd>
                </div>
                <div>
                  <dt class="font-semibold text-slate-500 uppercase tracking-wider text-[10px] dark:text-slate-400">
                    Profesional Asignado:
                  </dt>
                  <dd
                    id="res-doctor"
                    class="font-bold text-teal-700 text-sm mt-0.5 dark:text-teal-400"
                  >
                    Dra. Valentina Muñoz
                  </dd>
                </div>
                <div>
                  <dt class="font-semibold text-slate-500 uppercase tracking-wider text-[10px] dark:text-slate-400">
                    Fecha y Horario:
                  </dt>
                  <dd
                    id="res-datetime"
                    class="font-bold text-slate-900 text-sm mt-0.5 dark:text-white"
                  >
                    Jueves 12 Nov · 10:00 hrs
                  </dd>
                </div>
              </dl>

              <!-- Código QR Vectorial Dinámico de Recepción (4 cols) -->
              <div class="sm:col-span-4 flex flex-col items-center justify-center rounded-2xl bg-slate-50 border border-slate-200 p-3 text-center dark:bg-slate-800 dark:border-slate-700">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 100 100"
                  class="h-28 w-28 text-slate-900 fill-current dark:text-slate-100"
                  aria-label="Código QR de la reserva"
                >
                  <!-- QR SVG Mockup Vectorial de Alta Fidelidad -->
                  <rect
                    x="5"
                    y="5"
                    width="28"
                    height="28"
                    rx="4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="4"
                  />
                  <rect x="12" y="12" width="14" height="14" rx="2" fill="currentColor" />
                  <rect
                    x="67"
                    y="5"
                    width="28"
                    height="28"
                    rx="4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="4"
                  />
                  <rect x="74" y="12" width="14" height="14" rx="2" fill="currentColor" />
                  <rect
                    x="5"
                    y="67"
                    width="28"
                    height="28"
                    rx="4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="4"
                  />
                  <rect x="12" y="74" width="14" height="14" rx="2" fill="currentColor" />
                  <!-- Patrón central y módulos -->
                  <rect x="42" y="10" width="8" height="8" fill="currentColor" />
                  <rect x="53" y="10" width="6" height="6" fill="currentColor" />
                  <rect x="42" y="22" width="16" height="6" fill="currentColor" />
                  <rect x="10" y="42" width="6" height="14" fill="currentColor" />
                  <rect x="22" y="42" width="10" height="8" fill="currentColor" />
                  <rect x="40" y="40" width="20" height="20" rx="4" fill="#0d9488" />
                  <circle cx="50" cy="50" r="5" fill="white" />
                  <rect x="68" y="42" width="8" height="12" fill="currentColor" />
                  <rect x="80" y="42" width="10" height="6" fill="currentColor" />
                  <rect x="42" y="68" width="12" height="8" fill="currentColor" />
                  <rect x="58" y="68" width="10" height="18" fill="currentColor" />
                  <rect x="74" y="72" width="16" height="8" fill="currentColor" />
                  <rect x="42" y="82" width="8" height="10" fill="currentColor" />
                  <rect x="84" y="84" width="8" height="8" fill="currentColor" />
                </svg>
                <span class="mt-2 text-[10px] font-bold text-slate-500 uppercase tracking-tight dark:text-slate-400">
                  Pase Rápido Box
                </span>
              </div>
            </div>

            <!-- Pie del Comprobante -->
            <div class="mt-6 border-t border-slate-200 pt-3 text-[11px] text-slate-600 dark:border-slate-800 dark:text-slate-400">
              <p class="font-bold text-slate-800 dark:text-slate-200">
                Sede: Casa Matriz Providencia
              </p>
              <p>Av. Principal de las Mascotas 1234 · Tel: +56 9 1234 5678</p>
              <p class="text-[10px] text-teal-800 font-semibold mt-1 dark:text-teal-400">
                🚗 Presenta este código en recepción para ingreso preferencial al estacionamiento.
              </p>
            </div>
          </div>

          <!-- Botones de Acción (no-print) -->
          <div
            id="btn-print-area"
            class="no-print mt-8 flex flex-col sm:flex-row items-center justify-center gap-4"
          >
            <button
              type="button"
              onclick="window.print()"
              class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl border border-teal-600 bg-white px-7 py-3.5 text-sm font-bold text-teal-800 shadow-sm hover:bg-teal-50 transition dark:border-teal-500 dark:bg-slate-800 dark:text-teal-300 dark:hover:bg-slate-700"
            >
              🖨️ Imprimir Solo Comprobante Médico (PDF)
            </button>
            <a
              href="/"
              class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-teal-600 px-7 py-3.5 text-sm font-bold text-white shadow-md hover:bg-teal-700 transition dark:bg-teal-500 dark:text-slate-950 dark:hover:bg-teal-400"
            >
              Volver a la Página Principal
            </a>
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>

<script>
  // Estado reactivo en JS nativo
  const bookingState = {
    area: 'Consulta Médica General',
    specialtyCode: 'general',
    lockSpecies: false,
    date: '',
    dateLabel: '',
    doctor: '',
    time: '',
    ownerName: '',
    ownerPhone: '',
    ownerEmail: '',
    petName: '',
    petSpecies: 'Perro (Canino)',
  };

  function setStep(stepNumber) {
    document.querySelectorAll('.step-container').forEach((el) => el.classList.add('hidden'));

    const targetSection = document.getElementById(`step-${stepNumber}`);
    targetSection?.classList.remove('hidden');

    document.querySelectorAll('.step-indicator').forEach((indicator) => {
      const step = Number(indicator.getAttribute('data-step') || '1');
      const badge = indicator.querySelector('.step-badge');
      const label = indicator.querySelector('.step-label');

      if (step === stepNumber) {
        badge?.classList.remove(
          'bg-slate-100',
          'text-slate-500',
          'bg-emerald-600',
          'dark:bg-slate-800',
          'dark:text-slate-400'
        );
        badge?.classList.add(
          'bg-teal-600',
          'text-white',
          'dark:bg-teal-500',
          'dark:text-slate-950'
        );
        label?.classList.remove('text-slate-500', 'text-emerald-700', 'dark:text-slate-400');
        label?.classList.add('text-teal-700', 'font-bold', 'dark:text-teal-300');
      } else if (step < stepNumber) {
        badge?.classList.remove(
          'bg-slate-100',
          'text-slate-500',
          'bg-teal-600',
          'dark:bg-slate-800',
          'dark:text-slate-400',
          'dark:bg-teal-500',
          'dark:text-slate-950'
        );
        badge?.classList.add(
          'bg-emerald-600',
          'text-white',
          'dark:bg-emerald-500',
          'dark:text-slate-950'
        );
        label?.classList.remove(
          'text-teal-700',
          'text-slate-500',
          'dark:text-teal-300',
          'dark:text-slate-400'
        );
        label?.classList.add('text-emerald-700', 'font-medium', 'dark:text-emerald-300');
      } else {
        badge?.classList.remove(
          'bg-teal-600',
          'bg-emerald-600',
          'text-white',
          'dark:bg-teal-500',
          'dark:bg-emerald-500',
          'dark:text-slate-950'
        );
        badge?.classList.add(
          'bg-slate-100',
          'text-slate-500',
          'dark:bg-slate-800',
          'dark:text-slate-400'
        );
        label?.classList.remove(
          'text-teal-700',
          'text-emerald-700',
          'font-bold',
          'dark:text-teal-300',
          'dark:text-emerald-300'
        );
        label?.classList.add('text-slate-500', 'font-medium', 'dark:text-slate-400');
      }
    });

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // --- PASO 1: Selección de Especialidad ---
  const areaCards = document.querySelectorAll('.area-card');
  areaCards.forEach((card) => {
    card.addEventListener('click', () => {
      areaCards.forEach((c) => {
        c.classList.remove(
          'border-teal-500',
          'bg-teal-50/50',
          'ring-2',
          'ring-teal-500/20',
          'dark:border-teal-400',
          'dark:bg-teal-950/40',
          'dark:ring-teal-400/20'
        );
        c.classList.add('border-slate-200', 'dark:border-slate-800');
      });
      card.classList.remove('border-slate-200', 'dark:border-slate-800');
      card.classList.add(
        'border-teal-500',
        'bg-teal-50/50',
        'ring-2',
        'ring-teal-500/20',
        'dark:border-teal-400',
        'dark:bg-teal-950/40',
        'dark:ring-teal-400/20'
      );

      const radio = card.querySelector('input[type="radio"]');
      if (radio) {
        radio.checked = true;
        bookingState.area = radio.value;
        bookingState.specialtyCode = radio.getAttribute('data-code') || 'general';
        bookingState.lockSpecies = radio.getAttribute('data-lock-species') === 'true';
        const suggestedSpecies = radio.getAttribute('data-species');
        if (suggestedSpecies) {
          bookingState.petSpecies = suggestedSpecies;
        }
      }
    });
  });

  document.getElementById('btn-goto-step-2')?.addEventListener('click', () => {
    const selectedAreaRadio = document.querySelector('input[name="selected_area"]:checked');
    if (selectedAreaRadio) {
      bookingState.area = selectedAreaRadio.value;
      bookingState.specialtyCode = selectedAreaRadio.getAttribute('data-code') || 'general';
      bookingState.lockSpecies = selectedAreaRadio.getAttribute('data-lock-species') === 'true';
      const species = selectedAreaRadio.getAttribute('data-species');
      if (species) bookingState.petSpecies = species;
    }

    const summaryArea = document.getElementById('summary-area');
    if (summaryArea) summaryArea.textContent = bookingState.area;

    const filterServiceName = document.getElementById('filter-service-name');
    if (filterServiceName) filterServiceName.textContent = bookingState.area;

    // FILTRO ESTRICTO DE PROFESIONALES EN PASO 2
    const doctorRows = document.querySelectorAll('.doctor-row');
    let visibleCount = 0;
    doctorRows.forEach((row) => {
      const rawSpecs = row.getAttribute('data-specialties') || '';
      const specs = rawSpecs.split(',');
      if (specs.includes(bookingState.specialtyCode)) {
        row.classList.remove('hidden');
        visibleCount++;
      } else {
        row.classList.add('hidden');
      }
    });

    const countBadge = document.getElementById('summary-doctors-count');
    if (countBadge) {
      countBadge.textContent = `${visibleCount} ${visibleCount === 1 ? 'profesional disponible' : 'profesionales disponibles'}`;
    }

    // Resetear selección de médico/hora si no coincide con los filtrados
    bookingState.doctor = '';
    bookingState.time = '';
    document.querySelectorAll('.slot-btn').forEach((b) => {
      b.classList.remove('border-teal-600', 'bg-teal-600', 'text-white', 'shadow-md');
      b.classList.add('border-slate-300', 'bg-slate-50/70', 'text-slate-800');
    });

    const btnStep3 = document.getElementById('btn-goto-step-3');
    if (btnStep3) btnStep3.setAttribute('disabled', 'true');

    const selText = document.getElementById('selection-text');
    if (selText) {
      selText.textContent = `Fecha: ${bookingState.dateLabel}. Selecciona una hora para continuar.`;
    }

    setStep(2);
  });

  document.getElementById('btn-back-step-1')?.addEventListener('click', () => {
    setStep(1);
  });

  // --- PASO 2: Calendario con Bloqueo de Domingos y Días Pasados ---
  const calendarPicker = document.getElementById('calendar-picker');
  const dateChips = document.querySelectorAll('.date-chip');
  const calendarWarning = document.getElementById('calendar-warning');
  const slotButtons = document.querySelectorAll('.slot-btn');
  const selectionText = document.getElementById('selection-text');
  const btnGotoStep3 = document.getElementById('btn-goto-step-3');
  const step2Error = document.getElementById('step-2-error');

  function updateDateFromValue(dateStr, label) {
    const d = new Date(`${dateStr}T12:00:00`);
    const isSunday = d.getDay() === 0;

    bookingState.date = dateStr;
    const [y, m, dayNum] = dateStr.split('-');
    bookingState.dateLabel = label || `${isSunday ? 'Domingo' : 'Fecha'} ${dayNum}/${m}/${y}`;

    // Resetear hora elegida al cambiar de día
    bookingState.time = '';
    bookingState.doctor = '';
    slotButtons.forEach((b) => {
      b.classList.remove('border-teal-600', 'bg-teal-600', 'text-white', 'shadow-md');
      b.classList.add('border-slate-300', 'bg-slate-50/70', 'text-slate-800');
    });

    const slotsContainers = document.querySelectorAll('.slots-container');
    const sundayBlocks = document.querySelectorAll('.sunday-no-slots-msg');

    if (isSunday) {
      // 1. Mostrar alerta de domingo cerrado
      calendarWarning?.classList.remove('hidden');

      // 2. Ocultar todos los bloques de horas de los médicos
      slotsContainers.forEach((el) => el.classList.add('hidden'));
      sundayBlocks.forEach((el) => el.classList.remove('hidden'));

      // 3. Bloquear por completo el botón de continuar
      if (btnGotoStep3) {
        btnGotoStep3.setAttribute('disabled', 'true');
        btnGotoStep3.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
      }

      if (selectionText) {
        selectionText.innerHTML = `<span class="text-rose-300 font-bold">⛔ Domingo ${dayNum}/${m}: Sin horas disponibles. Selecciona un día hábil (lunes a sábado) para continuar.</span>`;
      }
    } else {
      // Día hábil (Lunes a Sábado)
      calendarWarning?.classList.add('hidden');

      // Mostrar las pastillas de horas
      slotsContainers.forEach((el) => el.classList.remove('hidden'));
      sundayBlocks.forEach((el) => el.classList.add('hidden'));

      // Restaurar estado base del botón
      if (btnGotoStep3) {
        btnGotoStep3.setAttribute('disabled', 'true');
        btnGotoStep3.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
      }

      if (selectionText) {
        selectionText.textContent = `Fecha: ${bookingState.dateLabel}. Selecciona una hora para continuar.`;
      }
    }
  }

  // Cambio desde el calendario nativo
  calendarPicker?.addEventListener('change', (e) => {
    const val = e.target.value;
    if (!val) return;

    // Sincronizar pastillas
    dateChips.forEach((chip) => {
      if (chip.getAttribute('data-date') === val) {
        chip.classList.remove(
          'border-slate-200',
          'bg-white',
          'text-slate-700',
          'dark:border-slate-700',
          'dark:bg-slate-800',
          'dark:text-slate-300'
        );
        chip.classList.add(
          'border-teal-600',
          'bg-teal-600',
          'text-white',
          'dark:border-teal-500',
          'dark:bg-teal-500',
          'dark:text-slate-950'
        );
      } else {
        chip.classList.remove(
          'border-teal-600',
          'bg-teal-600',
          'text-white',
          'dark:border-teal-500',
          'dark:bg-teal-500',
          'dark:text-slate-950'
        );
        chip.classList.add(
          'border-slate-200',
          'bg-white',
          'text-slate-700',
          'dark:border-slate-700',
          'dark:bg-slate-800',
          'dark:text-slate-300'
        );
      }
    });

    const [year, month, day] = val.split('-');
    const label = `${day}/${month}/${year}`;
    updateDateFromValue(val, label);
  });

  // Cambio desde las pastillas de acceso rápido (ya excluyen domingos)
  dateChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      dateChips.forEach((c) => {
        c.classList.remove(
          'border-teal-600',
          'bg-teal-600',
          'text-white',
          'dark:border-teal-500',
          'dark:bg-teal-500',
          'dark:text-slate-950'
        );
        c.classList.add(
          'border-slate-200',
          'bg-white',
          'text-slate-700',
          'dark:border-slate-700',
          'dark:bg-slate-800',
          'dark:text-slate-300'
        );
      });
      chip.classList.remove(
        'border-slate-200',
        'bg-white',
        'text-slate-700',
        'dark:border-slate-700',
        'dark:bg-slate-800',
        'dark:text-slate-300'
      );
      chip.classList.add(
        'border-teal-600',
        'bg-teal-600',
        'text-white',
        'dark:border-teal-500',
        'dark:bg-teal-500',
        'dark:text-slate-950'
      );

      const dateVal = chip.getAttribute('data-date');
      const dateLabel = chip.getAttribute('data-label');
      if (calendarPicker && dateVal) {
        calendarPicker.value = dateVal;
      }
      updateDateFromValue(dateVal, dateLabel);
    });
  });

  // --- Utilidades para cálculo dinámico de fechas ---
  const dayNamesShort = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
  const dayNamesLong = [
    'Domingo',
    'Lunes',
    'Martes',
    'Miércoles',
    'Jueves',
    'Viernes',
    'Sábado',
  ];
  const monthNamesLong = [
    'Enero',
    'Febrero',
    'Marzo',
    'Abril',
    'Mayo',
    'Junio',
    'Julio',
    'Agosto',
    'Septiembre',
    'Octubre',
    'Noviembre',
    'Diciembre',
  ];
  const monthNamesShort = [
    'Ene',
    'Feb',
    'Mar',
    'Abr',
    'May',
    'Jun',
    'Jul',
    'Ago',
    'Sep',
    'Oct',
    'Nov',
    'Dic',
  ];

  function formatDateISO(d) {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function formatDateLabels(d) {
    const dayOfWeek = d.getDay();
    const dayNum = d.getDate();
    const month = d.getMonth();
    const shortText = `${dayNamesShort[dayOfWeek]} ${dayNum} ${monthNamesShort[month]}`;
    const fullLabel = `${dayNamesLong[dayOfWeek]} ${dayNum} de ${monthNamesLong[month]}`;
    return { shortText, fullLabel };
  }

  function getNextWorkingDays(startDate, count = 5) {
    const days = [];
    const curr = new Date(startDate);
    while (days.length < count) {
      if (curr.getDay() !== 0) {
        const iso = formatDateISO(curr);
        const { shortText, fullLabel } = formatDateLabels(curr);
        days.push({
          date: iso,
          shortText,
          fullLabel,
        });
      }
      curr.setDate(curr.getDate() + 1);
    }
    return days;
  }

  function initDynamicDates() {
    const now = new Date();
    const todayISO = formatDateISO(now);

    if (calendarPicker) {
      calendarPicker.min = todayISO;
    }

    // Si hoy es domingo, el primer día hábil seleccionado es mañana (lunes)
    let initialDate = new Date(now);
    if (initialDate.getDay() === 0) {
      initialDate.setDate(initialDate.getDate() + 1);
    }

    const initialISO = formatDateISO(initialDate);
    const { fullLabel: initialLabel } = formatDateLabels(initialDate);

    bookingState.date = initialISO;
    bookingState.dateLabel = initialLabel;

    if (calendarPicker) {
      calendarPicker.value = initialISO;
    }

    // Actualizar los 5 chips con los próximos 5 días hábiles (saltando domingos)
    const workingDays = getNextWorkingDays(now, 5);
    dateChips.forEach((chip, index) => {
      const dayData = workingDays[index];
      if (dayData) {
        chip.setAttribute('data-date', dayData.date);
        chip.setAttribute('data-label', dayData.fullLabel);
        chip.textContent = dayData.shortText;

        if (index === 0) {
          chip.classList.remove(
            'border-slate-200',
            'bg-white',
            'text-slate-700',
            'dark:border-slate-700',
            'dark:bg-slate-800',
            'dark:text-slate-300'
          );
          chip.classList.add(
            'border-teal-600',
            'bg-teal-600',
            'text-white',
            'shadow-2xs',
            'dark:border-teal-500',
            'dark:bg-teal-500',
            'dark:text-slate-950'
          );
        } else {
          chip.classList.remove(
            'border-teal-600',
            'bg-teal-600',
            'text-white',
            'shadow-2xs',
            'dark:border-teal-500',
            'dark:bg-teal-500',
            'dark:text-slate-950'
          );
          chip.classList.add(
            'border-slate-200',
            'bg-white',
            'text-slate-700',
            'dark:border-slate-700',
            'dark:bg-slate-800',
            'dark:text-slate-300'
          );
        }
      }
    });

    updateDateFromValue(initialISO, initialLabel);
  }

  // Inicializar fechas dinámicas al cargar la página
  initDynamicDates();

  // Selección de Horario
  slotButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      slotButtons.forEach((b) => {
        b.classList.remove(
          'border-teal-600',
          'bg-teal-600',
          'text-white',
          'shadow-md',
          'dark:border-teal-400',
          'dark:bg-teal-500',
          'dark:text-slate-950'
        );
        b.classList.add(
          'border-slate-300',
          'bg-slate-50/70',
          'text-slate-800',
          'dark:border-slate-700',
          'dark:bg-slate-800/80',
          'dark:text-slate-200'
        );
      });
      btn.classList.remove(
        'border-slate-300',
        'bg-slate-50/70',
        'text-slate-800',
        'dark:border-slate-700',
        'dark:bg-slate-800/80',
        'dark:text-slate-200'
      );
      btn.classList.add(
        'border-teal-600',
        'bg-teal-600',
        'text-white',
        'shadow-md',
        'dark:border-teal-400',
        'dark:bg-teal-500',
        'dark:text-slate-950'
      );

      bookingState.doctor = btn.getAttribute('data-doctor') || '';
      bookingState.time = btn.getAttribute('data-time') || '';

      step2Error?.classList.add('hidden');
      if (btnGotoStep3) btnGotoStep3.removeAttribute('disabled');
      if (selectionText) {
        selectionText.textContent = `${bookingState.doctor} · ${bookingState.dateLabel} · ${bookingState.time} hrs`;
      }
    });
  });

  // Validación y configuración del Paso 3 (Bloqueo estricto de Especie)
  btnGotoStep3?.addEventListener('click', () => {
    const d = new Date(`${bookingState.date}T12:00:00`);
    if (d.getDay() === 0) {
      if (step2Error) {
        step2Error.classList.remove('hidden');
        step2Error.textContent =
          '⛔ Los días domingo no se agendan horas de consulta o spa (solo urgencias vitales 24/7). Por favor selecciona un día de lunes a sábado.';
        step2Error.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      return;
    }

    if (!bookingState.doctor || !bookingState.time) {
      if (step2Error) {
        step2Error.classList.remove('hidden');
        step2Error.textContent =
          '⚠️ Debes seleccionar un bloque de horario de uno de los profesionales para continuar.';
        step2Error.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      return;
    }

    const badgeSummary = document.getElementById('booking-badge-summary');
    if (badgeSummary) {
      badgeSummary.textContent = `${bookingState.doctor} · ${bookingState.dateLabel} · ${bookingState.time} hrs · Sede Casa Matriz`;
    }

    // APLICAR BLOQUEO ESTRICTO DE ESPECIE SEGÚN EL SERVICIO
    const speciesSelect = document.getElementById('b-pet-species');
    const lockedMsg = document.getElementById('species-locked-msg');
    const lockedName = document.getElementById('locked-species-name');
    const autofillBanner = document.getElementById('species-autofill-banner');

    if (speciesSelect) {
      speciesSelect.value = bookingState.petSpecies;

      if (bookingState.lockSpecies) {
        // Bloquear completamente para evitar que cambien a otra especie no permitida
        speciesSelect.setAttribute('disabled', 'true');
        speciesSelect.classList.add(
          'bg-slate-100',
          'text-slate-600',
          'cursor-not-allowed',
          'opacity-90'
        );
        lockedMsg?.classList.remove('hidden');
        if (lockedName) lockedName.textContent = bookingState.petSpecies;
        autofillBanner?.classList.add('hidden');
      } else {
        // Permitir cambiar libremente en servicios generales o cirugías
        speciesSelect.removeAttribute('disabled');
        speciesSelect.classList.remove(
          'bg-slate-100',
          'text-slate-600',
          'cursor-not-allowed',
          'opacity-90'
        );
        lockedMsg?.classList.add('hidden');
        autofillBanner?.classList.add('hidden');
      }
    }

    setStep(3);
  });

  document.getElementById('btn-back-step-2')?.addEventListener('click', () => {
    setStep(2);
  });

  // --- PASO 3: Validación del Formulario de Identificación ---
  const bookingForm = document.getElementById('booking-patient-form');
  const bookingFeedback = document.getElementById('booking-feedback');
  const btnBooking = document.getElementById('btn-confirm-booking');
  const btnBookingText = document.getElementById('btn-booking-text');
  const btnBookingSpinner = document.getElementById('btn-booking-spinner');

  function validate(input, errId, check) {
    const errEl = document.getElementById(errId);
    const valid = check(input);
    if (!valid) {
      errEl?.classList.remove('hidden');
      input?.classList.add('border-rose-400');
      input?.setAttribute('aria-invalid', 'true');
      return false;
    } else {
      errEl?.classList.add('hidden');
      input?.classList.remove('border-rose-400');
      input?.setAttribute('aria-invalid', 'false');
      return true;
    }
  }

  bookingForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const bot = document.getElementById('booking-bot');
    if (bot && bot.value.trim() !== '') {
      setStep(4);
      return;
    }

    const oName = document.getElementById('b-owner-name');
    const oPhone = document.getElementById('b-owner-phone');
    const oEmail = document.getElementById('b-owner-email');
    const pName = document.getElementById('b-pet-name');
    const pSpecies = document.getElementById('b-pet-species');

    const v1 = validate(oName, 'b-err-owner-name', (el) => el.value.trim().length >= 3);
    const v2 = validate(oPhone, 'b-err-owner-phone', (el) =>
      /^[0-9+ ]{8,15}$/.test(el.value.trim())
    );
    const v3 = validate(oEmail, 'b-err-owner-email', (el) =>
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim())
    );
    const v4 = validate(pName, 'b-err-pet-name', (el) => el.value.trim().length >= 1);

    // Si la especie está bloqueada, tomamos el valor del estado; si no, del select
    const currentSpecies = bookingState.lockSpecies ? bookingState.petSpecies : pSpecies?.value;
    const v5 = !!currentSpecies && currentSpecies.trim() !== '';

    if (!v1 || !v2 || !v3 || !v4 || !v5) {
      if (bookingFeedback) {
        bookingFeedback.classList.remove('hidden');
        bookingFeedback.classList.add('bg-rose-50', 'text-rose-800', 'border', 'border-rose-200');
        bookingFeedback.textContent =
          'Por favor completa todos los campos requeridos correctamente.';
      }
      return;
    }

    bookingState.ownerName = oName.value.trim();
    bookingState.ownerPhone = oPhone.value.trim();
    bookingState.ownerEmail = oEmail.value.trim();
    bookingState.petName = pName.value.trim();
    bookingState.petSpecies = currentSpecies;

    if (btnBooking && btnBookingText && btnBookingSpinner) {
      btnBooking.setAttribute('disabled', 'true');
      btnBookingText.textContent = 'Registrando tu cita médica...';
      btnBookingSpinner.classList.remove('hidden');
    }

    try {
      await new Promise((resolve) => setTimeout(resolve, 900));

      // Llenar datos en el comprobante imprimible con QR
      const resCode = document.getElementById('res-code');
      const resPet = document.getElementById('res-pet');
      const resOwner = document.getElementById('res-owner');
      const resDoctor = document.getElementById('res-doctor');
      const resDateTime = document.getElementById('res-datetime');

      const randomNum = Math.floor(1000 + Math.random() * 9000);
      if (resCode) resCode.textContent = `#HUE-2026-${randomNum}`;
      if (resPet) resPet.textContent = `${bookingState.petName} (${bookingState.petSpecies})`;
      if (resOwner) resOwner.textContent = `${bookingState.ownerName} (${bookingState.ownerPhone})`;
      if (resDoctor) resDoctor.textContent = bookingState.doctor;
      if (resDateTime)
        resDateTime.textContent = `${bookingState.dateLabel} · ${bookingState.time} hrs`;

      setStep(4);
    } catch {
      alert('Hubo un problema. Comunícate al +56 9 1234 5678.');
    } finally {
      if (btnBooking && btnBookingText && btnBookingSpinner) {
        btnBooking.removeAttribute('disabled');
        btnBookingText.textContent = 'Confirmar mi Reserva de Cita';
        btnBookingSpinner.classList.add('hidden');
      }
    }
  });
</script>
