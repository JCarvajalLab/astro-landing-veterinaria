---
// Componente de Contacto y Agendamiento con validación y antispam
---

<section id="contacto" class="border-t border-slate-200/80 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Encabezado de la sección -->
    <div class="text-center">
      <span class="inline-block rounded-full bg-teal-100 px-3.5 py-1 text-xs font-bold tracking-wider text-teal-800 uppercase">
        Agenda tu Atención
      </span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        Estamos aquí para cuidar a tu compañero
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-slate-600 sm:text-lg">
        Completa el formulario para coordinar tu cita médica o contáctanos por nuestros canales
        directos.
      </p>
    </div>

    <!-- Contenedor en 2 Columnas -->
    <div class="mt-12 grid grid-cols-1 items-start gap-12 lg:grid-cols-12">
      <!-- Columna Izquierda: Información de contacto directo (5 columnas) -->
      <div class="space-y-8 rounded-3xl border border-slate-200/90 bg-slate-50/70 p-6 sm:p-8 lg:col-span-5">
        <div>
          <h3 class="text-xl font-bold text-slate-900">Contacto Directo</h3>
          <p class="mt-2 text-sm text-slate-600">
            ¿Prefieres atención inmediata? Escríbenos o llámanos directamente. Nuestro equipo te
            atenderá con gusto.
          </p>
        </div>

        <!-- Alerta de Urgencias -->
        <div class="rounded-2xl border border-amber-300/80 bg-amber-50 p-4 text-amber-900">
          <div class="flex items-start gap-3">
            <svg
              class="h-5 w-5 shrink-0 text-amber-600 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
              />
            </svg>
            <div class="text-xs leading-relaxed">
              <span class="font-bold">¿Emergencia con riesgo vital?</span> No esperes respuesta del
              formulario. Llama directo a Urgencias 24/7 al
              <a href="tel:+56912345678" class="font-extrabold underline hover:text-amber-950">
                +56 9 1234 5678
              </a>
              .
            </div>
          </div>
        </div>

        <!-- Vías de Comunicación -->
        <ul class="space-y-4 text-sm text-slate-700">
          <li class="flex items-start gap-3.5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
            </span>
            <div>
              <p class="font-semibold text-slate-900">Ubicación de la Clínica</p>
              <p class="text-xs text-slate-600 mt-0.5">
                Av. Principal de las Mascotas 1234, Providencia, Santiago
              </p>
              <span class="mt-1 inline-block text-[11px] font-medium text-teal-700">
                Estacionamiento exclusivo para clientes
              </span>
            </div>
          </li>

          <li class="flex items-start gap-3.5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                />
              </svg>
            </span>
            <div>
              <p class="font-semibold text-slate-900">Teléfono y Guardia</p>
              <a href="tel:+56912345678" class="text-xs font-bold text-teal-700 hover:underline">
                +56 9 1234 5678
              </a>
              <p class="text-[11px] text-slate-500">Línea activa 24 horas</p>
            </div>
          </li>

          <li class="flex items-start gap-3.5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                />
              </svg>
            </span>
            <div>
              <p class="font-semibold text-slate-900">Correo Electrónico</p>
              <a
                href="mailto:contacto@huellitasveterinaria.cl"
                class="text-xs text-teal-700 hover:underline"
              >
                contacto@huellitasveterinaria.cl
              </a>
              <p class="text-[11px] text-slate-500">Respuesta en menos de 2 horas hábiles</p>
            </div>
          </li>
        </ul>

        <!-- Botón rápido WhatsApp -->
        <div class="pt-4 border-t border-slate-200/80">
          <a
            href="https://wa.me/56912345678?text=Hola,%20quisiera%20consultar%20por%20una%20hora%20médica%20en%20Veterinaria%20Huellitas"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-emerald-600 active:scale-98"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z" />
            </svg>
            Escribir por WhatsApp Directo
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Formulario de Agendamiento (7 columnas) -->
      <div class="rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-8 lg:col-span-7">
        <h3 class="text-xl font-bold text-slate-900">Formulario de Agendamiento</h3>
        <p class="mt-1 text-xs text-slate-500">
          Ingresa los datos solicitados y te confirmaremos el horario disponible a la brevedad.
        </p>

        <!-- Formulario -->
        <form id="appointment-form" class="mt-6 space-y-4" novalidate>
          <!-- Campo Honeypot Antispam (oculto para usuarios, visible para bots) -->
          <div class="hidden" aria-hidden="true">
            <label for="form-bot-check">Si eres humano deja este campo vacío</label>
            <input
              type="text"
              id="form-bot-check"
              name="website_url_check"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <!-- Fila 1: Nombre del Tutor y Teléfono -->
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label
                for="owner-name"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
              >
                Tu Nombre Completo <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="owner-name"
                name="owner_name"
                required
                minlength="3"
                maxlength="100"
                aria-describedby="error-owner-name"
                placeholder="Ej. Marcela Contreras"
                class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs placeholder:text-slate-400 focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
              />
              <p class="error-msg mt-1 hidden text-xs text-rose-600" id="error-owner-name">
                Ingresa al menos 3 caracteres.
              </p>
            </div>

            <div>
              <label
                for="owner-phone"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
              >
                Teléfono / WhatsApp <span class="text-rose-500">*</span>
              </label>
              <input
                type="tel"
                id="owner-phone"
                name="owner_phone"
                required
                maxlength="25"
                pattern="^[0-9+ ]{8,15}$"
                aria-describedby="error-owner-phone"
                placeholder="Ej. +56 9 8765 4321"
                class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs placeholder:text-slate-400 focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
              />
              <p class="error-msg mt-1 hidden text-xs text-rose-600" id="error-owner-phone">
                Ingresa un número telefónico válido (8 a 15 dígitos).
              </p>
            </div>
          </div>

          <!-- Fila 2: Correo Electrónico -->
          <div>
            <label
              for="owner-email"
              class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
            >
              Correo Electrónico <span class="text-rose-500">*</span>
            </label>
            <input
              type="email"
              id="owner-email"
              name="owner_email"
              required
              maxlength="120"
              aria-describedby="error-owner-email"
              placeholder="tu.correo@ejemplo.cl"
              class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs placeholder:text-slate-400 focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
            />
            <p class="error-msg mt-1 hidden text-xs text-rose-600" id="error-owner-email">
              Ingresa un correo electrónico válido.
            </p>
          </div>

          <!-- Fila 3: Nombre de Mascota y Especie -->
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label
                for="pet-name"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
              >
                Nombre de tu Mascota <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="pet-name"
                name="pet_name"
                required
                maxlength="100"
                aria-describedby="error-pet-name"
                placeholder="Ej. Simón, Luna, Rocky..."
                class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs placeholder:text-slate-400 focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
              />
              <p class="error-msg mt-1 hidden text-xs text-rose-600" id="error-pet-name">
                Por favor indica el nombre de la mascota.
              </p>
            </div>

            <div>
              <label
                for="pet-type"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
              >
                Tipo de Mascota <span class="text-rose-500">*</span>
              </label>
              <select
                id="pet-type"
                name="pet_type"
                required
                aria-describedby="error-pet-type"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
              >
                <option value="">Selecciona...</option>
                <option value="perro">Perro (Canino)</option>
                <option value="gato">Gato (Felino)</option>
                <option value="exotico">Animal Exótico / Otro</option>
              </select>
              <p class="error-msg mt-1 hidden text-xs text-rose-600" id="error-pet-type">
                Selecciona el tipo de mascota.
              </p>
            </div>
          </div>

          <!-- Fila 4: Servicio de Interés y Fecha Tentativa -->
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label
                for="service-required"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
              >
                Servicio Requerido <span class="text-rose-500">*</span>
              </label>
              <select
                id="service-required"
                name="service_required"
                required
                aria-describedby="error-service-required"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
              >
                <option value="">Selecciona especialidad...</option>
                <option value="consulta">Consulta Médica General</option>
                <option value="vacunas">Vacunación & Desparasitación</option>
                <option value="cirugia">Cirugía / Evaluación de Pabellón</option>
                <option value="spa">Peluquería Canina & Spa</option>
                <option value="laboratorio">Exámenes & Ecografía</option>
                <option value="urgencia">Urgencia Médica Prioritaria</option>
              </select>
              <p class="error-msg mt-1 hidden text-xs text-rose-600" id="error-service-required">
                Selecciona un servicio.
              </p>
            </div>

            <div>
              <label
                for="preferred-date"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
              >
                Fecha Preferida
              </label>
              <input
                type="date"
                id="preferred-date"
                name="preferred_date"
                class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
              />
            </div>
          </div>

          <!-- Fila 5: Mensaje / Motivo de consulta -->
          <div>
            <label
              for="consult-message"
              class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
            >
              Motivo de la Consulta o Síntomas
            </label>
            <textarea
              id="consult-message"
              name="consult_message"
              rows="3"
              maxlength="1000"
              placeholder="Cuéntanos brevemente cómo se siente tu mascota o qué consulta deseas realizar..."
              class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs placeholder:text-slate-400 focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
            ></textarea>
          </div>

          <!-- Consentimiento y Privacidad -->
          <div class="flex items-start gap-2.5 pt-2">
            <input
              type="checkbox"
              id="privacy-consent"
              name="privacy_consent"
              required
              aria-describedby="error-privacy-consent"
              class="h-4 w-4 rounded-sm border-slate-300 text-teal-600 focus:ring-teal-600"
            />
            <label for="privacy-consent" class="text-xs text-slate-600">
              Acepto que mis datos de contacto sean utilizados únicamente para coordinar la cita
              médica de mi mascota conforme a la política de privacidad.
            </label>
          </div>
          <p class="error-msg mt-1 hidden text-xs text-rose-600" id="error-privacy-consent">
            Debes aceptar la política de privacidad para agendar.
          </p>

          <!-- Mensajes de Estado Accesibles -->
          <div
            id="form-feedback"
            class="hidden rounded-xl p-4 text-sm font-medium"
            role="status"
            aria-live="polite"
          ></div>

          <!-- Botón de Envío -->
          <div class="pt-2">
            <button
              type="submit"
              id="submit-button"
              class="inline-flex w-full items-center justify-center rounded-xl bg-teal-600 px-6 py-3.5 text-base font-bold text-white shadow-md transition hover:bg-teal-700 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-2 active:scale-98 disabled:opacity-60"
            >
              <span id="btn-text">Confirmar Solicitud de Cita</span>
              <svg
                id="btn-spinner"
                class="ml-2 hidden h-5 w-5 animate-spin text-white"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"
                ></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('appointment-form');
  const botField = document.getElementById('form-bot-check');
  const submitBtn = document.getElementById('submit-button');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const feedback = document.getElementById('form-feedback');

  function showFeedback(type, message) {
    if (!feedback) return;
    feedback.classList.remove(
      'hidden',
      'bg-emerald-50',
      'text-emerald-800',
      'border',
      'border-emerald-200',
      'bg-rose-50',
      'text-rose-800',
      'border-rose-200'
    );

    if (type === 'success') {
      feedback.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
    } else {
      feedback.classList.add('bg-rose-50', 'text-rose-800', 'border', 'border-rose-200');
    }

    feedback.textContent = message;
    feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function validateInput(input, errorElementId, validator) {
    const errorEl = document.getElementById(errorElementId);
    const isValid = validator(input);
    if (!isValid) {
      errorEl?.classList.remove('hidden');
      input?.classList.add('border-rose-400');
      input?.setAttribute('aria-invalid', 'true');
      return false;
    } else {
      errorEl?.classList.add('hidden');
      input?.classList.remove('border-rose-400');
      input?.setAttribute('aria-invalid', 'false');
      return true;
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // 1. Detección Antispam con Honeypot (silent drop)
    if (botField && botField.value.trim() !== '') {
      console.warn('Bot submission blocked via honeypot.');
      showFeedback('success', '¡Gracias! Tu solicitud ha sido recibida con éxito.');
      form.reset();
      return;
    }

    // 2. Validaciones de campos accesibles
    const ownerName = document.getElementById('owner-name');
    const ownerPhone = document.getElementById('owner-phone');
    const ownerEmail = document.getElementById('owner-email');
    const petName = document.getElementById('pet-name');
    const petType = document.getElementById('pet-type');
    const serviceReq = document.getElementById('service-required');
    const privacyCheck = document.getElementById('privacy-consent');

    const v1 = validateInput(ownerName, 'error-owner-name', (el) => el.value.trim().length >= 3);
    const v2 = validateInput(ownerPhone, 'error-owner-phone', (el) =>
      /^[0-9+ ]{8,15}$/.test(el.value.trim())
    );
    const v3 = validateInput(ownerEmail, 'error-owner-email', (el) =>
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim())
    );
    const v4 = validateInput(petName, 'error-pet-name', (el) => el.value.trim().length >= 1);
    const v5 = validateInput(petType, 'error-pet-type', (el) => el.value.trim() !== '');
    const v6 = validateInput(serviceReq, 'error-service-required', (el) => el.value.trim() !== '');
    const v7 = validateInput(privacyCheck, 'error-privacy-consent', (el) => el.checked);

    if (!v1 || !v2 || !v3 || !v4 || !v5 || !v6 || !v7) {
      showFeedback('error', 'Por favor corrige los campos destacados antes de enviar.');
      return;
    }

    // 3. Estado de Envío
    if (submitBtn && btnText && btnSpinner) {
      submitBtn.setAttribute('disabled', 'true');
      btnText.textContent = 'Enviando solicitud...';
      btnSpinner.classList.remove('hidden');
    }

    try {
      // Simulación de envío seguro con delay
      await new Promise((resolve) => setTimeout(resolve, 1000));

      showFeedback(
        'success',
        `¡Solicitud recibida con éxito! Nos comunicaremos al número ${ownerPhone.value} para confirmar la cita de ${petName.value}. ¡Muchas gracias!`
      );
      form.reset();
      // Reset aria-invalid en todos los campos
      [ownerName, ownerPhone, ownerEmail, petName, petType, serviceReq, privacyCheck].forEach(
        (el) => {
          el?.removeAttribute('aria-invalid');
        }
      );
    } catch (err) {
      showFeedback(
        'error',
        'Hubo un error al procesar tu solicitud. Por favor intenta llamarnos directamente al +56 9 1234 5678.'
      );
    } finally {
      if (submitBtn && btnText && btnSpinner) {
        submitBtn.removeAttribute('disabled');
        btnText.textContent = 'Confirmar Solicitud de Cita';
        btnSpinner.classList.add('hidden');
      }
    }
  });
</script>
