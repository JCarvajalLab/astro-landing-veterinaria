---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import draValentinaImg from '../assets/team/dra-valentina.jpg';
import drCarlosImg from '../assets/team/dr-carlos.jpg';
import draCamilaImg from '../assets/team/dra-camila.jpg';
import rodrigoLagosImg from '../assets/team/rodrigo-lagos.jpg';
---

<Layout
  title="Reserva de Horas Médicas | Veterinaria Huellitas"
  description="Portal oficial de reserva y agendamiento de horas clínicas, cirugías, vacunación y spa para tu mascota en Santiago."
>
  <!-- Estilos de impresión exclusivos para el comprobante médico -->
  <style is:global>
    @media print {
      body {
        background-color: white !important;
      }
      header,
      footer,
      nav,
      .no-print,
      .skip-link {
        display: none !important;
      }
      .step-container {
        display: none !important;
      }
      #step-4 {
        display: block !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
      }
      #printable-receipt {
        display: block !important;
        box-shadow: none !important;
        border: 2px solid #0d9488 !important;
        background: white !important;
        margin: 0 auto !important;
        width: 100% !important;
        max-width: 100% !important;
      }
    }
  </style>

  <div class="min-h-screen bg-slate-100/70 py-8 sm:py-12 dark:bg-slate-950">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Barra Superior de Navegación del Portal (no-print) -->
      <div class="no-print flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200/90 pb-6 dark:border-slate-800">
        <div>
          <a
            href="/"
            class="inline-flex items-center gap-2 text-sm font-semibold text-teal-700 transition hover:text-teal-800 focus-visible:outline-2 focus-visible:outline-teal-600 dark:text-teal-400 dark:hover:text-teal-300"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              />
            </svg>
            Volver a la Página Principal
          </a>
          <h1 class="mt-2 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl dark:text-white">
            Portal de Reserva de Horas
          </h1>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Clínica Veterinaria Huellitas · Casa Matriz Providencia
          </p>
        </div>

        <div class="flex items-center gap-3">
          <div class="rounded-2xl border border-amber-200 bg-amber-50 px-3.5 py-2 text-right dark:border-amber-900/60 dark:bg-amber-950/40">
            <p class="text-[10px] font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">
              Urgencias Médicas 24/7
            </p>
            <a
              href="tel:+56912345678"
              class="text-sm font-extrabold text-amber-900 hover:underline dark:text-amber-200"
            >
              +56 9 1234 5678
            </a>
          </div>
        </div>
      </div>

      <!-- Stepper / Indicador de Progreso Visual Moderno (no-print) -->
      <nav
        aria-label="Progreso de reserva"
        class="no-print mt-8 rounded-3xl border border-slate-200/80 bg-white p-4 shadow-xs sm:p-6 dark:border-slate-800 dark:bg-slate-900"
      >
        <ol class="grid grid-cols-4 gap-2 sm:gap-4 text-center">
          <li class="step-indicator active flex flex-col items-center gap-1.5" data-step="1">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-teal-600 text-sm font-bold text-white shadow-xs transition dark:bg-teal-500 dark:text-slate-950">
              1
            </span>
            <span class="step-label text-[11px] sm:text-xs font-bold text-teal-700 dark:text-teal-300">
              Especialidad
            </span>
          </li>

          <li class="step-indicator flex flex-col items-center gap-1.5" data-step="2">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-500 transition dark:bg-slate-800 dark:text-slate-400">
              2
            </span>
            <span class="step-label text-[11px] sm:text-xs font-medium text-slate-500 dark:text-slate-400">
              Médico & Hora
            </span>
          </li>

          <li class="step-indicator flex flex-col items-center gap-1.5" data-step="3">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-500 transition dark:bg-slate-800 dark:text-slate-400">
              3
            </span>
            <span class="step-label text-[11px] sm:text-xs font-medium text-slate-500 dark:text-slate-400">
              Identificación
            </span>
          </li>

          <li class="step-indicator flex flex-col items-center gap-1.5" data-step="4">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-500 transition dark:bg-slate-800 dark:text-slate-400">
              4
            </span>
            <span class="step-label text-[11px] sm:text-xs font-medium text-slate-500 dark:text-slate-400">
              Confirmación
            </span>
          </li>
        </ol>
      </nav>

      <!-- CONTENEDOR PRINCIPAL DE PASOS -->
      <main class="mt-8">
        <!-- ========================================== -->
        <!-- PASO 1: SELECCIÓN DE ESPECIALIDAD -->
        <!-- ========================================== -->
        <section
          id="step-1"
          class="step-container rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-10 dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="border-b border-slate-100 pb-5 dark:border-slate-800">
            <span class="rounded-full bg-teal-100 px-3 py-1 text-xs font-bold text-teal-800 uppercase tracking-wider dark:bg-teal-950/70 dark:text-teal-300">
              Paso 1 de 4
            </span>
            <h2 class="mt-3 text-2xl font-extrabold text-slate-900 dark:text-white">
              Selecciona el Servicio o Especialidad
            </h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
              Elige la atención médica que requiere tu mascota para ver los horarios disponibles.
            </p>
          </div>

          <div
            class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
            role="radiogroup"
            aria-label="Especialidades médicas"
          >
            <!-- Consulta General -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-teal-500 bg-teal-50/50 ring-2 ring-teal-500/20 p-5 transition dark:border-teal-400 dark:bg-teal-950/40 dark:ring-teal-400/20">
              <input
                type="radio"
                name="selected_area"
                value="Consulta Médica General"
                data-code="general"
                data-species="Perro (Canino)"
                data-lock-species="false"
                class="sr-only"
                checked
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition dark:bg-teal-950/80 dark:text-teal-300">
                  🩺
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white">
                  Consulta Médica General
                </h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed dark:text-slate-400">
                  Revisión clínica completa, control de peso, nutrición y chequeo preventivo.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700 dark:text-teal-400">
                Ver disponibilidad (3 profesionales) →
              </span>
            </label>

            <!-- Medicina Felina (Solo Gatos) -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30 dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-teal-500 dark:hover:bg-teal-950/30">
              <input
                type="radio"
                name="selected_area"
                value="Medicina Felina Cat Friendly"
                data-code="felina"
                data-species="Gato (Felino)"
                data-lock-species="true"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition dark:bg-teal-950/80 dark:text-teal-300">
                  🐱
                </span>
                <div class="flex items-center gap-1.5 mt-4">
                  <h3 class="text-base font-bold text-slate-900 dark:text-white">
                    Medicina Felina
                  </h3>
                  <span class="rounded-md bg-cyan-100 px-1.5 py-0.5 text-[10px] font-bold text-cyan-800 dark:bg-cyan-950/80 dark:text-cyan-300">
                    Solo Gatos
                  </span>
                </div>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed dark:text-slate-400">
                  Atención Fear Free adaptada exclusivamente al comportamiento felino.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700 dark:text-teal-400">
                Ver disponibilidad (1 especialista) →
              </span>
            </label>

            <!-- Vacunación -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30 dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-teal-500 dark:hover:bg-teal-950/30">
              <input
                type="radio"
                name="selected_area"
                value="Vacunación & Desparasitación"
                data-code="vacunacion"
                data-species="Perro (Canino)"
                data-lock-species="false"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition dark:bg-teal-950/80 dark:text-teal-300">
                  💉
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white">
                  Vacunación & Desparasitación
                </h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed dark:text-slate-400">
                  Inmunización antirrábica, óctuple o triple felina con carnet sanitario.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700 dark:text-teal-400">
                Ver disponibilidad (2 profesionales) →
              </span>
            </label>

            <!-- Cirugía -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30 dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-teal-500 dark:hover:bg-teal-950/30">
              <input
                type="radio"
                name="selected_area"
                value="Cirugía & Pabellón"
                data-code="cirugia"
                data-species="Perro (Canino)"
                data-lock-species="false"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition dark:bg-teal-950/80 dark:text-teal-300">
                  🏥
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white">
                  Cirugía & Pabellón
                </h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed dark:text-slate-400">
                  Esterilizaciones, tejidos blandos y evaluación quirúrgica preanestésica.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700 dark:text-teal-400">
                Ver disponibilidad (1 cirujana) →
              </span>
            </label>

            <!-- Peluquería Canina (Solo Perros) -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30 dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-teal-500 dark:hover:bg-teal-950/30">
              <input
                type="radio"
                name="selected_area"
                value="Peluquería Canina & Spa"
                data-code="peluqueria"
                data-species="Perro (Canino)"
                data-lock-species="true"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition dark:bg-teal-950/80 dark:text-teal-300">
                  ✂️
                </span>
                <div class="flex items-center gap-1.5 mt-4">
                  <h3 class="text-base font-bold text-slate-900 dark:text-white">
                    Peluquería Canina & Spa
                  </h3>
                  <span class="rounded-md bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold text-amber-800 dark:bg-amber-950/80 dark:text-amber-300">
                    Solo Perros
                  </span>
                </div>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed dark:text-slate-400">
                  Baño dermatológico, corte de raza, deslanado y corte de uñas sin estrés.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700 dark:text-teal-400">
                Ver disponibilidad (1 peluquero) →
              </span>
            </label>

            <!-- Diagnóstico & Ecografía -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30 dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-teal-500 dark:hover:bg-teal-950/30">
              <input
                type="radio"
                name="selected_area"
                value="Laboratorio & Diagnóstico"
                data-code="laboratorio"
                data-species="Perro (Canino)"
                data-lock-species="false"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition dark:bg-teal-950/80 dark:text-teal-300">
                  🔬
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white">
                  Laboratorio & Ecografías
                </h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed dark:text-slate-400">
                  Perfil bioquímico rápido, radiografías digitales y ecografía abdominal.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700 dark:text-teal-400">
                Ver disponibilidad (2 especialistas) →
              </span>
            </label>
          </div>

          <!-- Selector de Sucursal fija -->
          <div class="mt-8 rounded-2xl bg-slate-50 p-4 sm:flex sm:items-center sm:justify-between border border-slate-200 dark:bg-slate-800/50 dark:border-slate-800">
            <div class="flex items-center gap-3">
              <span class="text-xl">📍</span>
              <div>
                <p class="text-xs font-bold text-slate-900 uppercase dark:text-white">
                  Sede Asignada:
                </p>
                <p class="text-sm text-slate-700 font-medium dark:text-slate-300">
                  Casa Matriz Providencia (Av. Principal de las Mascotas 1234)
                </p>
              </div>
            </div>
            <span class="mt-2 inline-block rounded-md bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-800 sm:mt-0 dark:bg-emerald-950/70 dark:text-emerald-300">
              Estacionamiento para Clientes
            </span>
          </div>

          <!-- Botón de avance -->
          <div class="mt-8 flex justify-end">
            <button
              type="button"
              id="btn-goto-step-2"
              class="inline-flex items-center gap-2 rounded-xl bg-teal-600 px-7 py-3.5 text-base font-bold text-white shadow-md transition hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600 active:scale-98 dark:bg-teal-500 dark:text-slate-950 dark:hover:bg-teal-400"
            >
              Buscar Médicos y Horarios Disponibles
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </button>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- PASO 2: SELECCIÓN DE MÉDICO, DÍA Y HORA -->
        <!-- ========================================== -->
        <section
          id="step-2"
          class="step-container hidden rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-10 dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200/80 pb-6 dark:border-slate-800">
            <div>
              <span class="rounded-full bg-teal-100 px-3 py-1 text-xs font-bold text-teal-800 uppercase tracking-wider dark:bg-teal-950/70 dark:text-teal-300">
                Paso 2 de 4
              </span>
              <h2 class="mt-2 text-2xl font-extrabold text-slate-900 dark:text-white">
                Selecciona Profesional y Horario
              </h2>
              <p class="text-xs text-slate-500 mt-0.5 dark:text-slate-400">
                Servicio:{' '}
                <span id="summary-area" class="font-bold text-teal-700 dark:text-teal-400">
                  Consulta Médica General
                </span>{' '}
                · Casa Matriz ·{' '}
                <span
                  id="summary-doctors-count"
                  class="font-semibold text-teal-900 bg-teal-50 px-2 py-0.5 rounded-md border border-teal-200 dark:bg-teal-950/70 dark:text-teal-300 dark:border-teal-800/60"
                >
                  3 profesionales disponibles
                </span>
              </p>
            </div>
            <button
              type="button"
              id="btn-back-step-1"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-teal-700 transition dark:text-slate-400 dark:hover:text-teal-300"
            >
              ← Cambiar Servicio
            </button>
          </div>

          <!-- Selector de Calendario y Fechas (Bloqueo de días pasados y domingos) -->
          <div class="mt-6 rounded-2xl bg-slate-50 p-5 border border-slate-200/90 dark:bg-slate-800/50 dark:border-slate-800">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <!-- Selector de Calendario Nativo -->
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-600 text-white shadow-xs dark:bg-teal-500 dark:text-slate-950">
                  📅
                </span>
                <div>
                  <label
                    for="calendar-picker"
                    class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                  >
                    Elegir Fecha en Calendario:
                  </label>
                  <input
                    type="date"
                    id="calendar-picker"
                    class="mt-1 rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:focus:border-teal-400"
                  />
                  <p class="text-[10px] text-slate-500 mt-0.5 dark:text-slate-400">
                    Días pasados bloqueados. Domingos cerrados para agenda regular.
                  </p>
                </div>
              </div>

              <!-- Pastillas de Acceso Rápido Próximos Días (Sin domingos) -->
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5 dark:text-slate-400">
                  Accesos Rápidos (Días Hábiles):
                </p>
                <div class="flex flex-wrap items-center gap-1.5" id="date-selector">
                  <button
                    type="button"
                    class="date-chip rounded-xl border border-teal-600 bg-teal-600 px-3 py-2 text-xs font-bold text-white shadow-2xs dark:border-teal-500 dark:bg-teal-500 dark:text-slate-950"
                    data-date="2026-11-12"
                    data-label="Jueves 12 de Noviembre"
                  >
                    Jue 12 Nov
                  </button>
                  <button
                    type="button"
                    class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-teal-400"
                    data-date="2026-11-13"
                    data-label="Viernes 13 de Noviembre"
                  >
                    Vie 13 Nov
                  </button>
                  <button
                    type="button"
                    class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-teal-400"
                    data-date="2026-11-14"
                    data-label="Sábado 14 de Noviembre"
                  >
                    Sáb 14 Nov
                  </button>
                  <button
                    type="button"
                    class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-teal-400"
                    data-date="2026-11-16"
                    data-label="Lunes 16 de Noviembre"
                  >
                    Lun 16 Nov
                  </button>
                  <button
                    type="button"
                    class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-teal-400"
                    data-date="2026-11-17"
                    data-label="Martes 17 de Noviembre"
                  >
                    Mar 17 Nov
                  </button>
                </div>
              </div>
            </div>

            <!-- Alerta reactiva de bloqueo dominical -->
            <div
              id="calendar-warning"
              class="mt-3 hidden rounded-2xl bg-rose-50 p-3.5 text-xs text-rose-900 border border-rose-300 flex items-start gap-2.5 dark:bg-rose-950/40 dark:border-rose-900/60 dark:text-rose-300"
              role="alert"
            >
              <span class="text-base shrink-0">⛔</span>
              <div>
                <strong class="font-bold text-rose-950 dark:text-rose-200">
                  Domingo seleccionado: Clínica cerrada para agenda regular.
                </strong>
                <p class="mt-0.5 text-rose-800 text-[11px] leading-relaxed dark:text-rose-300/90">
                  Los días domingo atendemos únicamente urgencias vitales 24/7 sin reserva previa.{' '}
                  <strong>
                    No es posible seleccionar horas ni continuar con la reserva en este día
                  </strong>
                  . Por favor selecciona un día de lunes a sábado en el calendario.
                </p>
              </div>
            </div>
          </div>

          <!-- Mensaje de aviso de selección obligatoria -->
          <div
