---
const schedules = [
  {
    area: 'Consultas Médicas & Especialidades',
    days: 'Lunes a Viernes',
    hours: '08:30 - 20:30 hrs',
    note: 'Atención con cita previa y orden de llegada',
  },
  {
    area: 'Atención Fin de Semana',
    days: 'Sábados y Domingos',
    hours: 'Sáb: 09:00 - 18:00 | Dom: 10:00 - 15:00 hrs',
    note: 'Consultas generales y retiro de exámenes',
  },
  {
    area: 'Peluquería Canina & Spa',
    days: 'Lunes a Sábado',
    hours: '09:00 - 18:00 hrs',
    note: 'Reserva previa recomendada',
  },
  {
    area: 'Urgencias Médicas & Pabellón',
    days: 'Lunes a Domingo',
    hours: '24 Horas Ininterrumpidas',
    note: 'Equipo médico de turno los 365 días del año',
    highlight: true,
  },
];
---

<section id="horarios" class="border-t border-slate-200/80 bg-slate-50 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="inline-block rounded-full bg-teal-100 px-3 py-1 text-xs font-bold tracking-wider text-teal-800 uppercase">
        Disponibilidad Clínica
      </span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        Horarios de atención adaptados a tu vida
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-slate-600 sm:text-lg">
        Sabemos que la salud de tu mascota no espera. Por eso contamos con cobertura médica integral
        todos los días.
      </p>
    </div>

    <!-- Grid de Horarios -->
    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {schedules.map((item) => (
        <article
          class={`flex flex-col justify-between rounded-2xl border p-6 shadow-xs transition hover:shadow-md ${
            item.highlight
              ? 'border-teal-500 bg-gradient-to-b from-teal-50 to-white ring-2 ring-teal-500/20'
              : 'border-slate-200/80 bg-white'
          }`}
        >
          <div>
            {item.highlight ? (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-600 px-3 py-1 text-xs font-bold text-white">
                <span class="h-2 w-2 rounded-full bg-white animate-pulse" aria-hidden="true"></span>
                Guardia 24/7 Activa
              </span>
            ) : (
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                {item.days}
              </span>
            )}

            <h3 class="mt-4 text-lg font-bold text-slate-900">{item.area}</h3>
            <p class="mt-2 text-xl font-extrabold text-teal-700">{item.hours}</p>
          </div>

          <p class="mt-4 border-t border-slate-100 pt-4 text-xs text-slate-500">{item.note}</p>
        </article>
      ))}
    </div>

    <!-- Banner directo de Urgencias telefónicas -->
    <div class="mt-12 rounded-2xl bg-teal-700 p-8 text-center text-white shadow-lg sm:flex sm:items-center sm:justify-between sm:text-left">
      <div>
        <h3 class="text-xl font-bold tracking-tight">¿Tienes una emergencia médica ahora mismo?</h3>
        <p class="mt-1 text-sm text-teal-100">
          Comunícate directamente a nuestra línea prioritaria de urgencias para preparar el box
          clínico antes de tu llegada.
        </p>
      </div>
      <a
        href="tel:+56912345678"
        class="mt-6 inline-flex shrink-0 items-center justify-center rounded-xl bg-white px-6 py-3 text-base font-bold text-teal-800 shadow-md transition hover:bg-teal-50 sm:mt-0 focus-visible:outline-2 focus-visible:outline-white"
      >
        <svg
          class="mr-2 h-5 w-5 text-teal-700"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          />
        </svg>
        Llamar a Urgencias: +56 9 1234 5678
      </a>
    </div>
  </div>
</section>
