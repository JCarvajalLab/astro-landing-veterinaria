---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import draValentinaImg from '../assets/team/dra-valentina.jpg';
import drCarlosImg from '../assets/team/dr-carlos.jpg';
import draCamilaImg from '../assets/team/dra-camila.jpg';
import rodrigoLagosImg from '../assets/team/rodrigo-lagos.jpg';
---

<Layout
  title="Reserva de Horas Médicas | Veterinaria Huellitas"
  description="Portal oficial de reserva y agendamiento de horas clínicas, cirugías, vacunación y spa para tu mascota en Santiago."
>
  <!-- Estilos de impresión exclusivos para el comprobante médico -->
  <style is:global>
    @media print {
      body {
        background-color: white !important;
      }
      header,
      footer,
      nav,
      .no-print,
      .skip-link {
        display: none !important;
      }
      .step-container {
        display: none !important;
      }
      #step-4 {
        display: block !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
      }
      #printable-receipt {
        display: block !important;
        box-shadow: none !important;
        border: 2px solid #0d9488 !important;
        background: white !important;
        margin: 0 auto !important;
        width: 100% !important;
        max-width: 100% !important;
      }
    }
  </style>

  <div class="min-h-screen bg-slate-100/70 py-8 sm:py-12">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Barra Superior de Navegación del Portal (no-print) -->
      <div class="no-print flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200/90 pb-6">
        <div>
          <a
            href="/"
            class="inline-flex items-center gap-2 text-sm font-semibold text-teal-700 transition hover:text-teal-800 focus-visible:outline-2 focus-visible:outline-teal-600"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              />
            </svg>
            Volver a la Página Principal
          </a>
          <h1 class="mt-2 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
            Portal de Reserva de Horas
          </h1>
          <p class="text-xs text-slate-500">
            Clínica Veterinaria Huellitas · Casa Matriz Providencia
          </p>
        </div>

        <div class="flex items-center gap-3">
          <div class="rounded-2xl border border-amber-200 bg-amber-50 px-3.5 py-2 text-right">
            <p class="text-[10px] font-bold uppercase tracking-wider text-amber-800">
              Urgencias Médicas 24/7
            </p>
            <a
              href="tel:+56912345678"
              class="text-sm font-extrabold text-amber-900 hover:underline"
            >
              +56 9 1234 5678
            </a>
          </div>
        </div>
      </div>

      <!-- Stepper / Indicador de Progreso Visual Moderno (no-print) -->
      <nav
        aria-label="Progreso de reserva"
        class="no-print mt-8 rounded-3xl border border-slate-200/80 bg-white p-4 shadow-xs sm:p-6"
      >
        <ol class="grid grid-cols-4 gap-2 sm:gap-4 text-center">
          <li class="step-indicator active flex flex-col items-center gap-1.5" data-step="1">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-teal-600 text-sm font-bold text-white shadow-xs transition">
              1
            </span>
            <span class="step-label text-[11px] sm:text-xs font-bold text-teal-700">
              Especialidad
            </span>
          </li>

          <li class="step-indicator flex flex-col items-center gap-1.5" data-step="2">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-500 transition">
              2
            </span>
            <span class="step-label text-[11px] sm:text-xs font-medium text-slate-500">
              Médico & Hora
            </span>
          </li>

          <li class="step-indicator flex flex-col items-center gap-1.5" data-step="3">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-500 transition">
              3
            </span>
            <span class="step-label text-[11px] sm:text-xs font-medium text-slate-500">
              Identificación
            </span>
          </li>

          <li class="step-indicator flex flex-col items-center gap-1.5" data-step="4">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-500 transition">
              4
            </span>
            <span class="step-label text-[11px] sm:text-xs font-medium text-slate-500">
              Confirmación
            </span>
          </li>
        </ol>
      </nav>

      <!-- CONTENEDOR PRINCIPAL DE PASOS -->
      <main class="mt-8">
        <!-- ========================================== -->
        <!-- PASO 1: SELECCIÓN DE ESPECIALIDAD -->
        <!-- ========================================== -->
        <section
          id="step-1"
          class="step-container rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-10"
        >
          <div class="border-b border-slate-100 pb-5">
            <span class="rounded-full bg-teal-100 px-3 py-1 text-xs font-bold text-teal-800 uppercase tracking-wider">
              Paso 1 de 4
            </span>
            <h2 class="mt-3 text-2xl font-extrabold text-slate-900">
              Selecciona el Servicio o Especialidad
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              Elige la atención médica que requiere tu mascota para ver los horarios disponibles.
            </p>
          </div>

          <div
            class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
            role="radiogroup"
            aria-label="Especialidades médicas"
          >
            <!-- Consulta General -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-teal-500 bg-teal-50/50 ring-2 ring-teal-500/20 p-5 transition">
              <input
                type="radio"
                name="selected_area"
                value="Consulta Médica General"
                data-species="Perro (Canino)"
                class="sr-only"
                checked
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  🩺
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900">Consulta Médica General</h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Revisión clínica completa, control de peso, nutrición y chequeo preventivo.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>

            <!-- Medicina Felina (Autoselecciona Gato) -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input
                type="radio"
                name="selected_area"
                value="Medicina Felina Cat Friendly"
                data-species="Gato (Felino)"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  🐱
                </span>
                <div class="flex items-center gap-1.5 mt-4">
                  <h3 class="text-base font-bold text-slate-900">Medicina Felina</h3>
                  <span class="rounded-md bg-cyan-100 px-1.5 py-0.5 text-[10px] font-bold text-cyan-800">
                    Solo Gatos
                  </span>
                </div>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Atención Fear Free adaptada exclusivamente al comportamiento felino.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>

            <!-- Vacunación -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input
                type="radio"
                name="selected_area"
                value="Vacunación & Desparasitación"
                data-species="Perro (Canino)"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  💉
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900">
                  Vacunación & Desparasitación
                </h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Inmunización antirrábica, óctuple o triple felina con carnet sanitario.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>

            <!-- Cirugía -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input
                type="radio"
                name="selected_area"
                value="Cirugía & Pabellón"
                data-species="Perro (Canino)"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  🏥
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900">Cirugía & Pabellón</h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Esterilizaciones, tejidos blandos y evaluación quirúrgica preanestésica.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>

            <!-- Peluquería Canina (Autoselecciona Perro) -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input
                type="radio"
                name="selected_area"
                value="Peluquería Canina & Spa"
                data-species="Perro (Canino)"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  ✂️
                </span>
                <div class="flex items-center gap-1.5 mt-4">
                  <h3 class="text-base font-bold text-slate-900">Peluquería Canina & Spa</h3>
                  <span class="rounded-md bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold text-amber-800">
                    Caninos
                  </span>
                </div>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Baño dermatológico, corte de raza, deslanado y corte de uñas sin estrés.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>

            <!-- Diagnóstico & Ecografía -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input
                type="radio"
                name="selected_area"
                value="Laboratorio & Diagnóstico"
                data-species="Perro (Canino)"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  🔬
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900">Laboratorio & Ecografías</h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Perfil bioquímico rápido, radiografías digitales y ecografía abdominal.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>
          </div>

          <!-- Selector de Sucursal fija -->
          <div class="mt-8 rounded-2xl bg-slate-50 p-4 sm:flex sm:items-center sm:justify-between border border-slate-200">
            <div class="flex items-center gap-3">
              <span class="text-xl">📍</span>
              <div>
                <p class="text-xs font-bold text-slate-900 uppercase">Sede Asignada:</p>
                <p class="text-sm text-slate-700 font-medium">
                  Casa Matriz Providencia (Av. Principal de las Mascotas 1234)
                </p>
              </div>
            </div>
            <span class="mt-2 inline-block rounded-md bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-800 sm:mt-0">
              Estacionamiento para Clientes
            </span>
          </div>

          <!-- Botón de avance -->
          <div class="mt-8 flex justify-end">
            <button
              type="button"
              id="btn-goto-step-2"
              class="inline-flex items-center gap-2 rounded-xl bg-teal-600 px-7 py-3.5 text-base font-bold text-white shadow-md transition hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600 active:scale-98"
            >
              Buscar Médicos y Horarios Disponibles
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </button>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- PASO 2: SELECCIÓN DE MÉDICO, DÍA Y HORA -->
        <!-- ========================================== -->
        <section
          id="step-2"
          class="step-container hidden rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-10"
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200/80 pb-6">
            <div>
              <span class="rounded-full bg-teal-100 px-3 py-1 text-xs font-bold text-teal-800 uppercase tracking-wider">
                Paso 2 de 4
              </span>
              <h2 class="mt-2 text-2xl font-extrabold text-slate-900">
                Selecciona Profesional y Horario
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">
                Servicio:{' '}
                <span id="summary-area" class="font-bold text-teal-700">
                  Consulta Médica General
                </span>{' '}
                · Casa Matriz
              </p>
            </div>
            <button
              type="button"
              id="btn-back-step-1"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-teal-700 transition"
            >
              ← Cambiar Servicio
            </button>
          </div>

          <!-- Selector de Calendario y Fechas (Bloqueo de días pasados) -->
          <div class="mt-6 rounded-2xl bg-slate-50 p-5 border border-slate-200/90">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <!-- Selector de Calendario Nativo -->
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-600 text-white shadow-xs">
                  📅
                </span>
                <div>
                  <label
                    for="calendar-picker"
                    class="block text-xs font-bold uppercase tracking-wider text-slate-700"
                  >
                    Elegir Fecha en Calendario:
                  </label>
                  <input
                    type="date"
                    id="calendar-picker"
                    min="2026-11-12"
                    value="2026-11-12"
                    class="mt-1 rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
                  />
                  <p class="text-[10px] text-slate-500 mt-0.5">
                    Días pasados bloqueados automáticamente.
                  </p>
                </div>
              </div>

              <!-- Pastillas de Acceso Rápido Próximos Días -->
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                  Accesos Rápidos:
                </p>
                <div class="flex flex-wrap items-center gap-1.5" id="date-selector">
                  <button
                    type="button"
                    class="date-chip rounded-xl border border-teal-600 bg-teal-600 px-3 py-2 text-xs font-bold text-white shadow-2xs"
                    data-date="2026-11-12"
                    data-label="Jueves 12 de Noviembre"
                  >
                    Jue 12 Nov
                  </button>
                  <button
                    type="button"
                    class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400"
                    data-date="2026-11-13"
                    data-label="Viernes 13 de Noviembre"
                  >
                    Vie 13 Nov
                  </button>
                  <button
                    type="button"
                    class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400"
                    data-date="2026-11-14"
                    data-label="Sábado 14 de Noviembre"
                  >
                    Sáb 14 Nov
                  </button>
                  <button
                    type="button"
                    class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400"
                    data-date="2026-11-16"
                    data-label="Lunes 16 de Noviembre"
                  >
                    Lun 16 Nov
                  </button>
                  <button
                    type="button"
                    class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400"
                    data-date="2026-11-17"
                    data-label="Martes 17 de Noviembre"
                  >
                    Mar 17 Nov
                  </button>
                </div>
              </div>
            </div>

            <div
              id="calendar-warning"
              class="mt-3 hidden rounded-xl bg-amber-50 p-2.5 text-xs text-amber-800 border border-amber-200"
            >
              ⚠️ Los días domingo atendemos medicina general por orden de llegada y urgencias 24/7.
              Te recomendamos seleccionar de lunes a sábado para cirugías y spa.
            </div>
          </div>

          <!-- Mensaje de aviso de selección obligatoria -->
          <div
            id="step-2-error"
            class="mt-6 hidden rounded-2xl border border-rose-200 bg-rose-50 p-4 text-xs font-bold text-rose-800"
          >
            ⚠️ Debes seleccionar un bloque de horario de uno de los profesionales para continuar.
          </div>

          <!-- Lista de Médicos y Horarios -->
          <div class="mt-6 space-y-6">
            <!-- Doctor 1: Dra. Valentina Muñoz -->
            <article class="doctor-row rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs transition hover:border-teal-300">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-center">
                <div class="flex items-center gap-4 md:col-span-4">
                  <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl shadow-sm ring-2 ring-teal-100">
                    <Image
                      src={draValentinaImg}
                      alt="Dra. Valentina Muñoz"
                      width={160}
                      height={160}
                      class="h-full w-full object-cover object-top"
                    />
                  </div>
                  <div>
                    <h3 class="text-base font-bold text-slate-900">Dra. Valentina Muñoz</h3>
                    <p class="text-xs font-semibold text-teal-700">Directora Médica & Cirugía</p>
                    <span class="mt-1.5 inline-block rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">
                      Próxima hora disponible: 10:00
                    </span>
                  </div>
                </div>

                <div class="md:col-span-8">
                  <p class="text-xs font-semibold text-slate-500 mb-2">
                    Selecciona una hora para esta fecha:
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {['10:00', '10:30', '11:30', '12:30', '15:00', '16:30'].map((time) => (
                      <button
                        type="button"
                        class="slot-btn rounded-xl border border-slate-300 bg-slate-50/70 px-4 py-2.5 font-mono text-xs font-bold text-slate-800 transition hover:border-teal-500 hover:bg-teal-50 hover:text-teal-900 focus-visible:outline-2 focus-visible:outline-teal-600"
                        data-doctor="Dra. Valentina Muñoz"
                        data-time={time}
                      >
                        {time} hrs
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </article>

            <!-- Doctor 2: Dr. Carlos Valenzuela -->
            <article class="doctor-row rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs transition hover:border-teal-300">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-center">
                <div class="flex items-center gap-4 md:col-span-4">
                  <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl shadow-sm ring-2 ring-teal-100">
                    <Image
                      src={drCarlosImg}
                      alt="Dr. Carlos Valenzuela"
                      width={160}
                      height={160}
                      class="h-full w-full object-cover object-top"
                    />
                  </div>
                  <div>
                    <h3 class="text-base font-bold text-slate-900">Dr. Carlos Valenzuela</h3>
                    <p class="text-xs font-semibold text-teal-700">Medicina Felina & Ecografía</p>
                    <span class="mt-1.5 inline-block rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">
                      Próxima hora disponible: 11:00
                    </span>
                  </div>
                </div>

                <div class="md:col-span-8">
                  <p class="text-xs font-semibold text-slate-500 mb-2">
                    Selecciona una hora para esta fecha:
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {['11:00', '12:00', '14:30', '16:00', '17:30'].map((time) => (
                      <button
                        type="button"
                        class="slot-btn rounded-xl border border-slate-300 bg-slate-50/70 px-4 py-2.5 font-mono text-xs font-bold text-slate-800 transition hover:border-teal-500 hover:bg-teal-50 hover:text-teal-900 focus-visible:outline-2 focus-visible:outline-teal-600"
                        data-doctor="Dr. Carlos Valenzuela"
                        data-time={time}
                      >
                        {time} hrs
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </article>

            <!-- Doctor 3: Dra. Camila Soto -->
            <article class="doctor-row rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs transition hover:border-teal-300">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-center">
                <div class="flex items-center gap-4 md:col-span-4">
                  <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl shadow-sm ring-2 ring-teal-100">
                    <Image
                      src={draCamilaImg}
                      alt="Dra. Camila Soto"
                      width={160}
                      height={160}
                      class="h-full w-full object-cover object-top"
                    />
                  </div>
                  <div>
