---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import draValentinaImg from '../assets/team/dra-valentina.jpg';
import drCarlosImg from '../assets/team/dr-carlos.jpg';
import draCamilaImg from '../assets/team/dra-camila.jpg';
import rodrigoLagosImg from '../assets/team/rodrigo-lagos.jpg';
---

<Layout
  title="Reserva de Horas Médicas | Veterinaria Huellitas"
  description="Portal oficial de reserva y agendamiento de horas clínicas, cirugías, vacunación y spa para tu mascota en Santiago."
>
  <div class="min-h-screen bg-slate-100/70 py-8 sm:py-12">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Barra Superior de Navegación del Portal -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200/90 pb-6">
        <div>
          <a
            href="/"
            class="inline-flex items-center gap-2 text-sm font-semibold text-teal-700 transition hover:text-teal-800 focus-visible:outline-2 focus-visible:outline-teal-600"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              />
            </svg>
            Volver a la Página Principal
          </a>
          <h1 class="mt-2 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
            Portal de Reserva de Horas
          </h1>
          <p class="text-xs text-slate-500">
            Clínica Veterinaria Huellitas · Casa Matriz Providencia
          </p>
        </div>

        <div class="flex items-center gap-3">
          <div class="rounded-2xl border border-amber-200 bg-amber-50 px-3.5 py-2 text-right">
            <p class="text-[10px] font-bold uppercase tracking-wider text-amber-800">
              Urgencias Médicas 24/7
            </p>
            <a
              href="tel:+56912345678"
              class="text-sm font-extrabold text-amber-900 hover:underline"
            >
              +56 9 1234 5678
            </a>
          </div>
        </div>
      </div>

      <!-- Stepper / Indicador de Progreso Visual Moderno -->
      <nav
        aria-label="Progreso de reserva"
        class="mt-8 rounded-3xl border border-slate-200/80 bg-white p-4 shadow-xs sm:p-6"
      >
        <ol class="grid grid-cols-4 gap-2 sm:gap-4 text-center">
          <!-- Paso 1 -->
          <li class="step-indicator active flex flex-col items-center gap-1.5" data-step="1">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-teal-600 text-sm font-bold text-white shadow-xs transition">
              1
            </span>
            <span class="step-label text-[11px] sm:text-xs font-bold text-teal-700">
              Especialidad
            </span>
          </li>

          <!-- Paso 2 -->
          <li class="step-indicator flex flex-col items-center gap-1.5" data-step="2">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-500 transition">
              2
            </span>
            <span class="step-label text-[11px] sm:text-xs font-medium text-slate-500">
              Médico & Hora
            </span>
          </li>

          <!-- Paso 3 -->
          <li class="step-indicator flex flex-col items-center gap-1.5" data-step="3">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-500 transition">
              3
            </span>
            <span class="step-label text-[11px] sm:text-xs font-medium text-slate-500">
              Identificación
            </span>
          </li>

          <!-- Paso 4 -->
          <li class="step-indicator flex flex-col items-center gap-1.5" data-step="4">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-500 transition">
              4
            </span>
            <span class="step-label text-[11px] sm:text-xs font-medium text-slate-500">
              Confirmación
            </span>
          </li>
        </ol>
      </nav>

      <!-- CONTENEDOR PRINCIPAL DE PASOS -->
      <main class="mt-8">
        <!-- ========================================== -->
        <!-- PASO 1: BÚSQUEDA Y SELECCIÓN DE ÁREA -->
        <!-- ========================================== -->
        <section
          id="step-1"
          class="step-container rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-10"
        >
          <div class="border-b border-slate-100 pb-5">
            <span class="rounded-full bg-teal-100 px-3 py-1 text-xs font-bold text-teal-800 uppercase tracking-wider">
              Paso 1 de 4
            </span>
            <h2 class="mt-3 text-2xl font-extrabold text-slate-900">
              Selecciona el Servicio o Especialidad
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              Elige la atención médica que requiere tu mascota para ver los horarios disponibles.
            </p>
          </div>

          <div
            class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
            role="radiogroup"
            aria-label="Especialidades médicas"
          >
            <!-- Opción 1: Consulta General -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input
                type="radio"
                name="selected_area"
                value="Consulta Médica General"
                class="sr-only"
                checked
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  🩺
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900">Consulta Médica General</h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Revisión clínica completa, control de peso, nutrición y diagnósticos.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>

            <!-- Opción 2: Medicina Felina -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input
                type="radio"
                name="selected_area"
                value="Medicina Felina Cat Friendly"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  🐱
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900">
                  Medicina Felina Especializada
                </h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Atención libre de estrés adaptada al comportamiento y salud del gato.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>

            <!-- Opción 3: Vacunación -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input
                type="radio"
                name="selected_area"
                value="Vacunación & Desparasitación"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  💉
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900">
                  Vacunación & Desparasitación
                </h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Esquemas caninos y felinos oficiales con certificado sanitario.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>

            <!-- Opción 4: Cirugía -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input type="radio" name="selected_area" value="Cirugía & Pabellón" class="sr-only" />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  🏥
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900">
                  Cirugía & Evaluación Quirúrgica
                </h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Esterilizaciones, tejidos blandos y valoración preanestésica.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>

            <!-- Opción 5: Peluquería & Spa -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input
                type="radio"
                name="selected_area"
                value="Peluquería Canina & Spa"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  ✂️
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900">Peluquería Canina & Spa</h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Baño terapéutico, corte de raza, deslanado y corte de uñas.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>

            <!-- Opción 6: Diagnóstico & Ecografía -->
            <label class="area-card group relative flex cursor-pointer flex-col justify-between rounded-2xl border-2 border-slate-200 p-5 transition hover:border-teal-400 hover:bg-teal-50/30">
              <input
                type="radio"
                name="selected_area"
                value="Laboratorio & Diagnóstico"
                class="sr-only"
              />
              <div>
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-800 shadow-2xs group-hover:scale-105 transition">
                  🔬
                </span>
                <h3 class="mt-4 text-base font-bold text-slate-900">Laboratorio & Ecografías</h3>
                <p class="mt-1 text-xs text-slate-500 leading-relaxed">
                  Exámenes sanguíneos, radiografías y ecografía abdominal.
                </p>
              </div>
              <span class="mt-4 inline-block text-xs font-bold text-teal-700">
                Ver disponibilidad →
              </span>
            </label>
          </div>

          <!-- Selector de Sucursal fija informativa -->
          <div class="mt-8 rounded-2xl bg-slate-50 p-4 sm:flex sm:items-center sm:justify-between border border-slate-200">
            <div class="flex items-center gap-3">
              <span class="text-xl">📍</span>
              <div>
                <p class="text-xs font-bold text-slate-900 uppercase">Centro de Atención:</p>
                <p class="text-sm text-slate-700 font-medium">
                  Casa Matriz Providencia (Av. Principal de las Mascotas 1234)
                </p>
              </div>
            </div>
            <span class="mt-2 inline-block rounded-md bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-800 sm:mt-0">
              Estacionamiento Disponible
            </span>
          </div>

          <!-- Botón de avance -->
          <div class="mt-8 flex justify-end">
            <button
              type="button"
              id="btn-goto-step-2"
              class="inline-flex items-center gap-2 rounded-xl bg-teal-600 px-7 py-3.5 text-base font-bold text-white shadow-md transition hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600 active:scale-98"
            >
              Buscar Médicos y Horarios Disponibles
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </button>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- PASO 2: SELECCIÓN DE MÉDICO Y HORA -->
        <!-- ========================================== -->
        <section
          id="step-2"
          class="step-container hidden rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-10"
        >
          <!-- Cabecera de contexto seleccionado -->
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200/80 pb-6">
            <div>
              <span class="rounded-full bg-teal-100 px-3 py-1 text-xs font-bold text-teal-800 uppercase tracking-wider">
                Paso 2 de 4
              </span>
              <h2 class="mt-2 text-2xl font-extrabold text-slate-900">
                Selecciona Profesional y Horario
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">
                Servicio:{' '}
                <span id="summary-area" class="font-bold text-teal-700">
                  Consulta Médica General
                </span>{' '}
                · Sede Casa Matriz
              </p>
            </div>
            <button
              type="button"
              id="btn-back-step-1"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-teal-700 transition"
            >
              ← Cambiar Servicio
            </button>
          </div>

          <!-- Selector de Fecha / Día -->
          <div class="mt-6 rounded-2xl bg-slate-50 p-4 border border-slate-200/80">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <div>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">
                  Semana de Atención:
                </p>
                <p class="text-sm font-extrabold text-slate-900">Noviembre 2026</p>
              </div>

              <!-- Pastillas de días -->
              <div class="flex flex-wrap items-center gap-1.5" id="date-selector">
                <button
                  type="button"
                  class="date-chip rounded-xl border border-teal-600 bg-teal-600 px-3 py-2 text-xs font-bold text-white shadow-2xs"
                  data-date="Jueves 12 de Noviembre"
                >
                  Jue 12
                </button>
                <button
                  type="button"
                  class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400"
                  data-date="Viernes 13 de Noviembre"
                >
                  Vie 13
                </button>
                <button
                  type="button"
                  class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400"
                  data-date="Sábado 14 de Noviembre"
                >
                  Sáb 14
                </button>
                <button
                  type="button"
                  class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400"
                  data-date="Lunes 16 de Noviembre"
                >
                  Lun 16
                </button>
                <button
                  type="button"
                  class="date-chip rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:border-teal-400"
                  data-date="Martes 17 de Noviembre"
                >
                  Mar 17
                </button>
              </div>
            </div>
          </div>

          <!-- Lista de Médicos con sus bloques de horas -->
          <div class="mt-8 space-y-6">
            <!-- Doctor 1: Dra. Valentina Muñoz -->
            <article class="doctor-row rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs transition hover:border-teal-300">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-center">
                <!-- Info del Doctor (4 cols) -->
                <div class="flex items-center gap-4 md:col-span-4">
                  <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl shadow-sm ring-2 ring-teal-100">
                    <Image
                      src={draValentinaImg}
                      alt="Dra. Valentina Muñoz"
                      width={160}
                      height={160}
                      class="h-full w-full object-cover object-top"
                    />
                  </div>
                  <div>
                    <h3 class="text-base font-bold text-slate-900">Dra. Valentina Muñoz</h3>
                    <p class="text-xs font-semibold text-teal-700">Directora Médica & Cirugía</p>
                    <span class="mt-1.5 inline-block rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">
                      Hora más próxima hoy: 10:00
                    </span>
                  </div>
                </div>

                <!-- Bloques de Horas Disponibles (8 cols) -->
                <div class="md:col-span-8">
                  <p class="text-xs font-semibold text-slate-500 mb-2">
                    Selecciona un bloque de hora:
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {['10:00', '10:30', '11:30', '12:30', '15:00', '16:30'].map((time) => (
                      <button
                        type="button"
                        class="slot-btn rounded-xl border border-slate-300 bg-slate-50/70 px-4 py-2.5 font-mono text-xs font-bold text-slate-800 transition hover:border-teal-500 hover:bg-teal-50 hover:text-teal-900 focus-visible:outline-2 focus-visible:outline-teal-600"
                        data-doctor="Dra. Valentina Muñoz"
                        data-time={time}
                      >
                        {time} hrs
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </article>

            <!-- Doctor 2: Dr. Carlos Valenzuela -->
            <article class="doctor-row rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs transition hover:border-teal-300">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-center">
                <!-- Info del Doctor (4 cols) -->
                <div class="flex items-center gap-4 md:col-span-4">
                  <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl shadow-sm ring-2 ring-teal-100">
                    <Image
                      src={drCarlosImg}
                      alt="Dr. Carlos Valenzuela"
                      width={160}
                      height={160}
                      class="h-full w-full object-cover object-top"
                    />
                  </div>
                  <div>
                    <h3 class="text-base font-bold text-slate-900">Dr. Carlos Valenzuela</h3>
                    <p class="text-xs font-semibold text-teal-700">Medicina Felina & Ecografía</p>
                    <span class="mt-1.5 inline-block rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">
                      Hora más próxima hoy: 11:00
                    </span>
                  </div>
                </div>

                <!-- Bloques de Horas -->
                <div class="md:col-span-8">
                  <p class="text-xs font-semibold text-slate-500 mb-2">
                    Selecciona un bloque de hora:
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {['11:00', '12:00', '14:30', '16:00', '17:30'].map((time) => (
                      <button
                        type="button"
                        class="slot-btn rounded-xl border border-slate-300 bg-slate-50/70 px-4 py-2.5 font-mono text-xs font-bold text-slate-800 transition hover:border-teal-500 hover:bg-teal-50 hover:text-teal-900 focus-visible:outline-2 focus-visible:outline-teal-600"
                        data-doctor="Dr. Carlos Valenzuela"
                        data-time={time}
                      >
                        {time} hrs
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </article>

            <!-- Doctor 3: Dra. Camila Soto -->
            <article class="doctor-row rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs transition hover:border-teal-300">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-center">
                <!-- Info del Doctor (4 cols) -->
                <div class="flex items-center gap-4 md:col-span-4">
                  <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl shadow-sm ring-2 ring-teal-100">
                    <Image
                      src={draCamilaImg}
                      alt="Dra. Camila Soto"
                      width={160}
                      height={160}
                      class="h-full w-full object-cover object-top"
                    />
                  </div>
                  <div>
                    <h3 class="text-base font-bold text-slate-900">Dra. Camila Soto</h3>
                    <p class="text-xs font-semibold text-teal-700">Dermatología & Vacunación</p>
                    <span class="mt-1.5 inline-block rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">
                      Hora más próxima hoy: 09:30
                    </span>
                  </div>
                </div>

                <!-- Bloques de Horas -->
                <div class="md:col-span-8">
                  <p class="text-xs font-semibold text-slate-500 mb-2">
                    Selecciona un bloque de hora:
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {['09:30', '10:15', '12:00', '15:30', '17:00'].map((time) => (
                      <button
                        type="button"
                        class="slot-btn rounded-xl border border-slate-300 bg-slate-50/70 px-4 py-2.5 font-mono text-xs font-bold text-slate-800 transition hover:border-teal-500 hover:bg-teal-50 hover:text-teal-900 focus-visible:outline-2 focus-visible:outline-teal-600"
                        data-doctor="Dra. Camila Soto"
                        data-time={time}
                      >
                        {time} hrs
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </article>

            <!-- Técnico: Rodrigo Lagos -->
            <article class="doctor-row rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs transition hover:border-teal-300">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-center">
                <!-- Info del Profesional (4 cols) -->
                <div class="flex items-center gap-4 md:col-span-4">
                  <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl shadow-sm ring-2 ring-teal-100">
                    <Image
                      src={rodrigoLagosImg}
                      alt="Rodrigo Lagos"
                      width={160}
                      height={160}
                      class="h-full w-full object-cover object-top"
                    />
                  </div>
                  <div>
                    <h3 class="text-base font-bold text-slate-900">Rodrigo Lagos</h3>
                    <p class="text-xs font-semibold text-teal-700">Técnico Jefe Peluquería & Spa</p>
                    <span class="mt-1.5 inline-block rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">
                      Hora más próxima hoy: 09:00
                    </span>
                  </div>
                </div>

                <!-- Bloques de Horas -->
                <div class="md:col-span-8">
                  <p class="text-xs font-semibold text-slate-500 mb-2">
                    Selecciona un bloque de hora:
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {['09:00', '11:00', '14:00', '16:00'].map((time) => (
                      <button
                        type="button"
                        class="slot-btn rounded-xl border border-slate-300 bg-slate-50/70 px-4 py-2.5 font-mono text-xs font-bold text-slate-800 transition hover:border-teal-500 hover:bg-teal-50 hover:text-teal-900 focus-visible:outline-2 focus-visible:outline-teal-600"
                        data-doctor="Rodrigo Lagos"
                        data-time={time}
                      >
                        {time} hrs
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          </div>

          <!-- Barra flotante de selección activa y avance al paso 3 -->
          <div
            id="selection-bar"
            class="mt-8 hidden rounded-2xl bg-teal-800 p-5 text-white shadow-lg sm:flex sm:items-center sm:justify-between"
          >
            <div>
              <p class="text-xs uppercase tracking-wider text-teal-200 font-bold">
                Cita Médica Seleccionada:
              </p>
              <p id="selection-text" class="text-base font-black text-white mt-0.5">
                Dra. Valentina Muñoz · Jueves 12 Nov · 10:00 hrs
              </p>
            </div>
            <button
              type="button"
              id="btn-goto-step-3"
              class="mt-4 sm:mt-0 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-bold text-teal-900 shadow-md transition hover:bg-teal-50 active:scale-98"
            >
              Continuar con mis Datos
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </button>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- PASO 3: IDENTIFICACIÓN DEL TUTOR Y PACIENTE -->
        <!-- ========================================== -->
        <section
          id="step-3"
          class="step-container hidden rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-10"
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200/80 pb-6">
            <div>
              <span class="rounded-full bg-teal-100 px-3 py-1 text-xs font-bold text-teal-800 uppercase tracking-wider">
                Paso 3 de 4
              </span>
              <h2 class="mt-2 text-2xl font-extrabold text-slate-900">
                Datos del Tutor y Paciente
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">
                Ingresa los datos para registrar la ficha médica de tu mascota.
              </p>
            </div>
            <button
              type="button"
              id="btn-back-step-2"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-teal-700 transition"
            >
              ← Cambiar Médico u Hora
            </button>
          </div>

          <!-- Resumen de la reserva elegida -->
          <div class="mt-6 rounded-2xl bg-teal-50/70 border border-teal-200 p-4">
            <div class="flex items-center gap-3">
              <span class="text-2xl">📋</span>
              <div>
                <p class="text-xs font-bold uppercase text-teal-800">Cita en Coordinación:</p>
                <p id="booking-badge-summary" class="text-sm font-extrabold text-teal-950">
                  Dra. Valentina Muñoz · Jueves 12 Nov · 10:00 hrs · Sede Casa Matriz
                </p>
              </div>
            </div>
          </div>

          <!-- Formulario de Identificación -->
          <form id="booking-patient-form" class="mt-6 space-y-4" novalidate>
            <!-- Honeypot -->
            <div class="hidden" aria-hidden="true">
              <input
                type="text"
                id="booking-bot"
                name="bot_honey"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label
                  for="b-owner-name"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
                >
                  Tu Nombre Completo <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="b-owner-name"
                  required
                  minlength="3"
                  maxlength="100"
                  aria-describedby="b-err-owner-name"
                  placeholder="Ej. Marcela Contreras"
                  class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
                />
                <p class="error-msg mt-1 hidden text-xs text-rose-600" id="b-err-owner-name">
                  Ingresa tu nombre completo.
                </p>
              </div>

              <div>
                <label
                  for="b-owner-phone"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
                >
                  WhatsApp o Teléfono <span class="text-rose-500">*</span>
                </label>
                <input
                  type="tel"
                  id="b-owner-phone"
                  required
                  maxlength="25"
                  pattern="^[0-9+ ]{8,15}$"
                  aria-describedby="b-err-owner-phone"
                  placeholder="Ej. +56 9 8765 4321"
                  class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
                />
                <p class="error-msg mt-1 hidden text-xs text-rose-600" id="b-err-owner-phone">
                  Ingresa un número telefónico válido.
                </p>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label
                  for="b-owner-email"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
                >
                  Correo Electrónico <span class="text-rose-500">*</span>
                </label>
                <input
                  type="email"
                  id="b-owner-email"
                  required
                  maxlength="120"
                  aria-describedby="b-err-owner-email"
                  placeholder="marcela@ejemplo.cl"
                  class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
                />
                <p class="error-msg mt-1 hidden text-xs text-rose-600" id="b-err-owner-email">
                  Ingresa un correo electrónico válido.
                </p>
              </div>

              <div>
                <label
                  for="b-pet-name"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
                >
                  Nombre de tu Mascota <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="b-pet-name"
                  required
                  maxlength="100"
                  aria-describedby="b-err-pet-name"
                  placeholder="Ej. Simón, Luna, Toby..."
                  class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
                />
                <p class="error-msg mt-1 hidden text-xs text-rose-600" id="b-err-pet-name">
                  Indica el nombre de la mascota.
                </p>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label
                  for="b-pet-species"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
                >
                  Especie de la Mascota <span class="text-rose-500">*</span>
                </label>
                <select
                  id="b-pet-species"
                  required
                  aria-describedby="b-err-pet-species"
                  class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
                >
                  <option value="">Selecciona...</option>
                  <option value="Perro (Canino)">Perro (Canino)</option>
                  <option value="Gato (Felino)">Gato (Felino)</option>
                  <option value="Conejo / Roedor">Conejo / Roedor</option>
                  <option value="Ave / Exótico">Ave / Exótico</option>
                </select>
                <p class="error-msg mt-1 hidden text-xs text-rose-600" id="b-err-pet-species">
                  Selecciona la especie.
                </p>
              </div>

              <div>
                <label
                  for="b-pet-age"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
                >
                  Edad Aproximada
                </label>
                <input
                  type="text"
                  id="b-pet-age"
                  maxlength="50"
                  placeholder="Ej. 2 años, 5 meses..."
                  class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
                />
              </div>
            </div>

            <div>
              <label
                for="b-notes"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider"
              >
                Motivo o Síntomas Observados
              </label>
              <textarea
                id="b-notes"
                rows="3"
                maxlength="800"
                placeholder="Indícanos si viene por control preventivo, decaimiento, vómitos, cojera, vacuna anual, etc."
                class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20"
              ></textarea>
            </div>

            <!-- Feedback -->
            <div
              id="booking-feedback"
              class="hidden rounded-xl p-3 text-sm font-medium"
              role="status"
              aria-live="polite"
            ></div>

            <div class="mt-6 flex justify-end">
              <button
                type="submit"
                id="btn-confirm-booking"
                class="inline-flex items-center gap-2 rounded-xl bg-teal-600 px-8 py-3.5 text-base font-bold text-white shadow-md transition hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600 active:scale-98 disabled:opacity-60"
              >
                <span id="btn-booking-text">Confirmar mi Reserva de Cita</span>
                <svg
                  id="btn-booking-spinner"
                  class="ml-2 hidden h-5 w-5 animate-spin text-white"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"
                  ></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
              </button>
            </div>
          </form>
        </section>

        <!-- ========================================== -->
        <!-- PASO 4: CONFIRMACIÓN DE RESERVA EXITOSA -->
        <!-- ========================================== -->
        <section
          id="step-4"
          class="step-container hidden rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-10 text-center"
        >
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-emerald-100 text-emerald-600 shadow-md">
            <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"
              />
            </svg>
          </div>

          <span class="mt-5 inline-block rounded-full bg-emerald-50 px-3.5 py-1 text-xs font-bold text-emerald-800 uppercase tracking-wider">
            ¡Reserva Confirmada con Éxito!
          </span>

          <h2 class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            La cita de tu mascota ha sido agendada
          </h2>
          <p class="mt-2 text-sm text-slate-600 max-w-lg mx-auto">
            Hemos registrado tu hora médica y enviado el comprobante a tu correo electrónico y
            WhatsApp.
          </p>

          <!-- Tarjeta de Comprobante de Reserva -->
          <div class="mt-8 mx-auto max-w-xl rounded-2xl border-2 border-dashed border-teal-300 bg-teal-50/40 p-6 text-left shadow-xs">
            <div class="flex items-center justify-between border-b border-teal-200/60 pb-3">
              <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">
                Código de Reserva
              </span>
              <span id="res-code" class="font-mono text-sm font-black text-teal-800">
                #HUE-2026-8942
              </span>
            </div>

            <dl class="mt-4 grid grid-cols-1 gap-y-3 sm:grid-cols-2 text-xs">
              <div>
                <dt class="font-medium text-slate-500">Mascota / Paciente:</dt>
                <dd id="res-pet" class="font-bold text-slate-900 text-sm mt-0.5">
                  Simón (Perro)
                </dd>
              </div>
              <div>
                <dt class="font-medium text-slate-500">Tutor Responsable:</dt>
                <dd id="res-owner" class="font-bold text-slate-900 text-sm mt-0.5">
                  Marcela Contreras
                </dd>
              </div>
              <div>
                <dt class="font-medium text-slate-500">Profesional Médico:</dt>
                <dd id="res-doctor" class="font-bold text-teal-700 text-sm mt-0.5">
                  Dra. Valentina Muñoz
                </dd>
              </div>
              <div>
                <dt class="font-medium text-slate-500">Fecha y Hora:</dt>
                <dd id="res-datetime" class="font-bold text-slate-900 text-sm mt-0.5">
                  Jueves 12 Nov · 10:00 hrs
                </dd>
              </div>
              <div class="sm:col-span-2 border-t border-teal-200/40 pt-2.5">
                <dt class="font-medium text-slate-500">Lugar de Atención:</dt>
                <dd class="font-bold text-slate-800 mt-0.5">
                  Clínica Huellitas Providencia · Av. Principal de las Mascotas 1234
                  (Estacionamiento Clientes)
                </dd>
              </div>
            </dl>
          </div>

          <!-- Recomendaciones previas -->
          <div class="mt-6 mx-auto max-w-xl rounded-xl bg-slate-50 p-4 text-xs text-slate-600 text-left border border-slate-200">
            <p class="font-bold text-slate-800">📌 Recomendaciones para el día de la cita:</p>
            <ul class="mt-1.5 list-disc list-inside space-y-1 text-slate-500">
              <li>Presentarse 10 minutos antes en recepción.</li>
              <li>Traer carnet de vacunas previo (si aplica).</li>
              <li>Perros con correa y gatos en transportadora para su seguridad y tranquilidad.</li>
            </ul>
          </div>

          <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
            <button
              type="button"
              onclick="window.print()"
              class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-700 shadow-2xs hover:bg-slate-50 transition"
            >
              🖨️ Imprimir / Guardar Comprobante
            </button>
            <a
              href="/"
              class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-teal-600 px-6 py-3 text-sm font-bold text-white shadow-md hover:bg-teal-700 transition"
            >
              Volver al Inicio
            </a>
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>

<script>
  // Estado local de la reserva en JS nativo
  const bookingState = {
    area: 'Consulta Médica General',
    date: 'Jueves 12 de Noviembre',
    doctor: '',
    time: '',
    ownerName: '',
    ownerPhone: '',
    ownerEmail: '',
    petName: '',
    petSpecies: '',
  };

  function setStep(stepNumber) {
    // 1. Ocultar todas las secciones
    document.querySelectorAll('.step-container').forEach((el) => el.classList.add('hidden'));

    // 2. Mostrar la sección activa
    const targetSection = document.getElementById(`step-${stepNumber}`);
    targetSection?.classList.remove('hidden');

    // 3. Actualizar indicadores del stepper
    document.querySelectorAll('.step-indicator').forEach((indicator) => {
      const step = Number(indicator.getAttribute('data-step') || '1');
      const badge = indicator.querySelector('.step-badge');
      const label = indicator.querySelector('.step-label');

      if (step === stepNumber) {
        badge?.classList.remove('bg-slate-100', 'text-slate-500', 'bg-emerald-600');
        badge?.classList.add('bg-teal-600', 'text-white');
        label?.classList.remove('text-slate-500', 'text-emerald-700');
        label?.classList.add('text-teal-700', 'font-bold');
      } else if (step < stepNumber) {
        badge?.classList.remove('bg-slate-100', 'text-slate-500', 'bg-teal-600');
        badge?.classList.add('bg-emerald-600', 'text-white');
        label?.classList.remove('text-teal-700', 'text-slate-500');
        label?.classList.add('text-emerald-700', 'font-medium');
      } else {
        badge?.classList.remove('bg-teal-600', 'bg-emerald-600', 'text-white');
        badge?.classList.add('bg-slate-100', 'text-slate-500');
        label?.classList.remove('text-teal-700', 'text-emerald-700', 'font-bold');
        label?.classList.add('text-slate-500', 'font-medium');
      }
    });

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // --- Manejo del Paso 1 ---
  const areaCards = document.querySelectorAll('.area-card');
  areaCards.forEach((card) => {
    card.addEventListener('click', () => {
      areaCards.forEach((c) => {
        c.classList.remove('border-teal-500', 'bg-teal-50/50', 'ring-2', 'ring-teal-500/20');
        c.classList.add('border-slate-200');
      });
      card.classList.remove('border-slate-200');
      card.classList.add('border-teal-500', 'bg-teal-50/50', 'ring-2', 'ring-teal-500/20');

      const radio = card.querySelector('input[type="radio"]');
      if (radio) {
        radio.checked = true;
        bookingState.area = radio.value;
      }
    });
  });

  document.getElementById('btn-goto-step-2')?.addEventListener('click', () => {
    const selectedAreaRadio = document.querySelector('input[name="selected_area"]:checked');
    if (selectedAreaRadio) {
      bookingState.area = selectedAreaRadio.value;
    }
    const summaryArea = document.getElementById('summary-area');
    if (summaryArea) summaryArea.textContent = bookingState.area;
    setStep(2);
  });

  document.getElementById('btn-back-step-1')?.addEventListener('click', () => {
    setStep(1);
  });

  // --- Manejo del Paso 2: Días y Horarios ---
  const dateChips = document.querySelectorAll('.date-chip');
  dateChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      dateChips.forEach((c) => {
        c.classList.remove('border-teal-600', 'bg-teal-600', 'text-white');
        c.classList.add('border-slate-200', 'bg-white', 'text-slate-700');
      });
      chip.classList.remove('border-slate-200', 'bg-white', 'text-slate-700');
      chip.classList.add('border-teal-600', 'bg-teal-600', 'text-white');
      bookingState.date = chip.getAttribute('data-date') || 'Fecha elegida';
      updateSelectionBar();
    });
  });

  const slotButtons = document.querySelectorAll('.slot-btn');
  const selectionBar = document.getElementById('selection-bar');
  const selectionText = document.getElementById('selection-text');

  function updateSelectionBar() {
    if (bookingState.doctor && bookingState.time) {
      selectionBar?.classList.remove('hidden');
      if (selectionText) {
        selectionText.textContent = `${bookingState.doctor} · ${bookingState.date} · ${bookingState.time} hrs`;
      }
    }
  }

  slotButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      slotButtons.forEach((b) => {
        b.classList.remove('border-teal-600', 'bg-teal-600', 'text-white', 'shadow-md');
        b.classList.add('border-slate-300', 'bg-slate-50/70', 'text-slate-800');
      });
      btn.classList.remove('border-slate-300', 'bg-slate-50/70', 'text-slate-800');
      btn.classList.add('border-teal-600', 'bg-teal-600', 'text-white', 'shadow-md');

      bookingState.doctor = btn.getAttribute('data-doctor') || '';
      bookingState.time = btn.getAttribute('data-time') || '';
      updateSelectionBar();
    });
  });

  document.getElementById('btn-goto-step-3')?.addEventListener('click', () => {
    const badgeSummary = document.getElementById('booking-badge-summary');
    if (badgeSummary) {
      badgeSummary.textContent = `${bookingState.doctor} · ${bookingState.date} · ${bookingState.time} hrs · Sede Casa Matriz`;
    }
    setStep(3);
  });

  document.getElementById('btn-back-step-2')?.addEventListener('click', () => {
    setStep(2);
  });

  // --- Manejo del Paso 3: Identificación ---
  const bookingForm = document.getElementById('booking-patient-form');
  const bookingFeedback = document.getElementById('booking-feedback');
  const btnBooking = document.getElementById('btn-confirm-booking');
  const btnBookingText = document.getElementById('btn-booking-text');
  const btnBookingSpinner = document.getElementById('btn-booking-spinner');

  function validate(input, errId, check) {
    const errEl = document.getElementById(errId);
    const valid = check(input);
    if (!valid) {
      errEl?.classList.remove('hidden');
      input?.classList.add('border-rose-400');
      input?.setAttribute('aria-invalid', 'true');
      return false;
    } else {
      errEl?.classList.add('hidden');
      input?.classList.remove('border-rose-400');
      input?.setAttribute('aria-invalid', 'false');
      return true;
    }
  }

  bookingForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const bot = document.getElementById('booking-bot');
    if (bot && bot.value.trim() !== '') {
      setStep(4);
      return;
    }

    const oName = document.getElementById('b-owner-name');
    const oPhone = document.getElementById('b-owner-phone');
    const oEmail = document.getElementById('b-owner-email');
    const pName = document.getElementById('b-pet-name');
    const pSpecies = document.getElementById('b-pet-species');

    const v1 = validate(oName, 'b-err-owner-name', (el) => el.value.trim().length >= 3);
    const v2 = validate(oPhone, 'b-err-owner-phone', (el) =>
      /^[0-9+ ]{8,15}$/.test(el.value.trim())
    );
    const v3 = validate(oEmail, 'b-err-owner-email', (el) =>
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim())
    );
    const v4 = validate(pName, 'b-err-pet-name', (el) => el.value.trim().length >= 1);
    const v5 = validate(pSpecies, 'b-err-pet-species', (el) => el.value.trim() !== '');

    if (!v1 || !v2 || !v3 || !v4 || !v5) {
      if (bookingFeedback) {
        bookingFeedback.classList.remove('hidden');
        bookingFeedback.classList.add('bg-rose-50', 'text-rose-800', 'border', 'border-rose-200');
        bookingFeedback.textContent =
          'Por favor completa todos los campos obligatorios antes de confirmar.';
      }
      return;
    }

    bookingState.ownerName = oName.value.trim();
    bookingState.ownerPhone = oPhone.value.trim();
    bookingState.ownerEmail = oEmail.value.trim();
    bookingState.petName = pName.value.trim();
    bookingState.petSpecies = pSpecies.value;

    if (btnBooking && btnBookingText && btnBookingSpinner) {
      btnBooking.setAttribute('disabled', 'true');
      btnBookingText.textContent = 'Registrando tu cita médica...';
      btnBookingSpinner.classList.remove('hidden');
    }

    try {
      await new Promise((resolve) => setTimeout(resolve, 1000));

      // Llenar datos en el comprobante del Paso 4
      const resCode = document.getElementById('res-code');
      const resPet = document.getElementById('res-pet');
      const resOwner = document.getElementById('res-owner');
      const resDoctor = document.getElementById('res-doctor');
      const resDateTime = document.getElementById('res-datetime');

      const randomNum = Math.floor(1000 + Math.random() * 9000);
      if (resCode) resCode.textContent = `#HUE-2026-${randomNum}`;
      if (resPet) resPet.textContent = `${bookingState.petName} (${bookingState.petSpecies})`;
      if (resOwner) resOwner.textContent = `${bookingState.ownerName} (${bookingState.ownerPhone})`;
      if (resDoctor) resDoctor.textContent = bookingState.doctor;
      if (resDateTime) resDateTime.textContent = `${bookingState.date} · ${bookingState.time} hrs`;

      setStep(4);
    } catch {
      alert(
        'Hubo un problema al conectar con el servicio. Por favor intenta llamarnos al +56 9 1234 5678.'
      );
    } finally {
      if (btnBooking && btnBookingText && btnBookingSpinner) {
        btnBooking.removeAttribute('disabled');
        btnBookingText.textContent = 'Confirmar mi Reserva de Cita';
        btnBookingSpinner.classList.add('hidden');
      }
    }
  });
</script>
