---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';

const {
  title = 'Veterinaria Huellitas | Cuidado Integral y Amor para tu Mascota',
  description = 'Clínica veterinaria con servicios de consulta, vacunación, cirugía, urgencias 24/7 y peluquería canina y felina en Providencia, Santiago.',
  image = '/og-image.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://veterinariahuellitas.cl');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'VeterinaryCare',
  name: 'Clínica Veterinaria Huellitas',
  image: 'https://veterinariahuellitas.cl/og-image.jpg',
  telephone: '+56912345678',
  email: 'contacto@huellitasveterinaria.cl',
  url: 'https://veterinariahuellitas.cl',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. Principal de las Mascotas 1234',
    addressLocality: 'Providencia',
    addressRegion: 'Región Metropolitana',
    postalCode: '7500000',
    addressCountry: 'CL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -33.4255,
    longitude: -70.615,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '20:30',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '09:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday'],
      opens: '00:00',
      closes: '23:59',
      description: 'Atención de guardia y urgencias vitales 24 horas',
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios Clínicos Veterinarios',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Consulta Médica General & Chequeo Preventivo',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Medicina Felina Cat Friendly',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Cirugía & Pabellón Anestésico Monitorizado',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Peluquería Canina & Spa Dermatológico',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Urgencias Médicas Veterinarias 24/7',
        },
      },
    ],
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Veterinaria Huellitas" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Theme Color dinámico para navegadores móviles -->
    <meta name="theme-color" content="#0d9488" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />

    <!-- Schema.org JSON-LD estructurado para Google Rich Results -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Script síncrono anti-parpadeo (anti-FOUC) para Modo Nocturno -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch {
          // Fallback silencioso si el almacenamiento local está restringido
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-800 antialiased selection:bg-teal-100 selection:text-teal-900 dark:bg-slate-900 dark:text-slate-100 dark:selection:bg-teal-900/60 dark:selection:text-teal-200 transition-colors duration-200">
    <a href="#main-content" class="skip-link">
      Saltar al contenido principal
    </a>

    <Navbar />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
    <BookingModal />

    <!-- Botón Flotante Rápido de Urgencias para Dispositivos Móviles -->
    <aside class="fixed bottom-4 right-4 z-40 md:hidden" aria-label="Contacto de Urgencias Móvil">
      <a
        href="tel:+56912345678"
        class="group flex items-center gap-2 rounded-full bg-gradient-to-r from-amber-500 to-rose-600 px-4 py-3 text-xs font-bold text-white shadow-xl shadow-rose-950/30 transition active:scale-95 border border-white/20"
        aria-label="Llamar inmediatamente a Urgencias Veterinarias 24 Horas"
      >
        <span class="relative flex h-2.5 w-2.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-75"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-white"></span>
        </span>
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z" />
        </svg>
        <span>Urgencias 24/7</span>
      </a>
    </aside>
  </body>
</html>
