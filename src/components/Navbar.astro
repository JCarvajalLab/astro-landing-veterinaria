---
const navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#testimonios', label: 'Testimonios' },
  { href: '#horarios', label: 'Horarios' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Logotipo y Nombre -->
    <a
      href="/"
      class="flex items-center gap-2 text-xl font-bold tracking-tight text-slate-900 transition hover:text-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-2"
      aria-label="Veterinaria Huellitas - Inicio"
    >
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-600 text-white shadow-sm">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <circle cx="12" cy="15" r="4" />
          <circle cx="6.5" cy="11.5" r="2" />
          <circle cx="10" cy="7.5" r="2" />
          <circle cx="14" cy="7.5" r="2" />
          <circle cx="17.5" cy="11.5" r="2" />
        </svg>
      </span>
      <span>
        Huellitas<span class="text-teal-600">.</span>
      </span>
    </a>

    <!-- Enlaces de navegación de escritorio -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-slate-600 transition hover:text-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-2"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Botón CTA escritorio -->
    <div class="hidden items-center gap-3 md:flex">
      <a
        href="/agendar"
        class="inline-flex items-center justify-center rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-2 active:scale-98"
      >
        Agendar Cita
      </a>
    </div>

    <!-- Botón Hamburguesa móvil -->
    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-teal-600 md:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <!-- Icono Menú -->
      <svg
        id="icon-open"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
      <!-- Icono Cerrar -->
      <svg
        id="icon-close"
        class="hidden h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        />
      </svg>
    </button>
  </div>

  <!-- Menú móvil desplegable -->
  <div id="mobile-menu" class="hidden border-b border-slate-200 bg-white px-4 pt-2 pb-6 md:hidden">
    <nav class="flex flex-col gap-3" aria-label="Navegación móvil">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link rounded-md px-3 py-2 text-base font-medium text-slate-700 transition hover:bg-slate-100 hover:text-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/agendar"
        class="mobile-nav-link mt-2 inline-flex items-center justify-center rounded-lg bg-teal-600 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600"
      >
        Agendar Cita
      </a>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
    toggleBtn?.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  }

  toggleBtn?.addEventListener('click', toggleMenu);

  // Cerrar al hacer clic en un enlace del menú móvil
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });

  // Cerrar con la tecla Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
      toggleMenu();
      toggleBtn?.focus();
    }
  });
</script>
