---
// Componente Hero para la clínica veterinaria
import { Image } from 'astro:assets';
import heroPetImg from '../assets/hero-pet.jpg';
---

<section class="relative min-h-[calc(100vh-4.5rem)] flex flex-col justify-center overflow-hidden bg-slate-50 dark:bg-slate-900 py-12 sm:py-16 lg:py-20 transition-colors duration-200">
  <!-- Adorno de fondo difuminado -->
  <div
    class="pointer-events-none absolute -top-24 right-0 -z-10 h-96 w-96 rounded-full bg-teal-200/40 dark:bg-teal-900/20 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-24 -left-24 -z-10 h-96 w-96 rounded-full bg-amber-100/40 dark:bg-amber-950/20 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Columna de texto principal -->
      <div class="text-center lg:col-span-7 lg:text-left">
        <!-- Badge superior de urgencias -->
        <div class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-teal-100/80 dark:border-teal-800/60 dark:bg-teal-950/70 px-3.5 py-1.5 text-xs font-semibold text-teal-900 dark:text-teal-300 shadow-xs">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-600 dark:bg-teal-400"></span>
          </span>
          Urgencias Veterinarias 24 Horas · Los 365 días del año
        </div>

        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
          El cuidado y amor que tu mascota{' '}
          <span class="text-teal-600 dark:text-teal-400">realmente merece</span>
        </h1>

        <p class="mt-6 text-lg leading-relaxed text-slate-600 dark:text-slate-300 sm:text-xl">
          Somos más que una clínica: somos la segunda familia de tu peludo. Medicina preventiva de
          excelencia, especialistas dedicados y tecnología diagnóstica en un ambiente libre de
          estrés.
        </p>

        <!-- Botones de Acción (CTA) -->
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:justify-center lg:justify-start">
          <a
            href="/agendar"
            class="inline-flex items-center justify-center rounded-xl bg-teal-600 px-6 py-3.5 text-base font-bold text-white shadow-md transition hover:bg-teal-700 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-2 active:scale-98"
          >
            Agendar Consulta Médica
            <svg
              class="ml-2 h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </a>
          <a
            href="#servicios"
            class="inline-flex items-center justify-center rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-6 py-3.5 text-base font-bold text-slate-700 dark:text-slate-200 shadow-xs transition hover:bg-slate-50 dark:hover:bg-slate-700 hover:text-slate-900 dark:hover:text-white focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-2"
          >
            Explorar Servicios
          </a>
        </div>

        <!-- Indicador de confianza rápido en píldoras limpias (sin línea cortada) -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2.5 text-xs text-slate-600 dark:text-slate-300 lg:justify-start">
          <div class="inline-flex items-center gap-1.5 rounded-full border border-slate-200/80 bg-white/70 px-3 py-1.5 shadow-2xs backdrop-blur-xs dark:border-slate-700/70 dark:bg-slate-800/80">
            <svg
              class="h-3.5 w-3.5 text-teal-600 dark:text-teal-400"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"
              />
            </svg>
            <span class="font-medium">Veterinarios Colegiados</span>
          </div>
          <div class="inline-flex items-center gap-1.5 rounded-full border border-slate-200/80 bg-white/70 px-3 py-1.5 shadow-2xs backdrop-blur-xs dark:border-slate-700/70 dark:bg-slate-800/80">
            <svg
              class="h-3.5 w-3.5 text-teal-600 dark:text-teal-400"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"
              />
            </svg>
            <span class="font-medium">Manejo Libre de Estrés (Fear Free)</span>
          </div>
          <div class="inline-flex items-center gap-1.5 rounded-full border border-slate-200/80 bg-white/70 px-3 py-1.5 shadow-2xs backdrop-blur-xs dark:border-slate-700/70 dark:bg-slate-800/80">
            <svg
              class="h-3.5 w-3.5 text-teal-600 dark:text-teal-400"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"
              />
            </svg>
            <span class="font-medium">Pabellón de Alta Complejidad</span>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Fotografía médica cálida y métricas de impacto -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-950/80 p-5 shadow-xl lg:max-w-none transition-colors duration-200">
          <!-- Imagen fotográfica cálida de paciente y profesional con badge superpuesto -->
          <div class="group relative h-64 sm:h-72 w-full overflow-hidden rounded-2xl shadow-inner">
            <Image
              src={heroPetImg}
              alt="Veterinaria examinando con cariño y dedicación a un paciente canino"
              class="h-full w-full object-cover object-center transition duration-500 group-hover:scale-105"
              loading="eager"
            />
            <!-- Gradiente para contraste de texto -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>

            <!-- Badges flotantes sobre la foto -->
            <div class="absolute top-3 right-3">
              <span class="inline-flex items-center gap-1 rounded-full bg-teal-600/90 px-2.5 py-1 text-[11px] font-bold text-white shadow-md backdrop-blur-xs">
                ★ 4.9 · +850 Reseñas
              </span>
            </div>

            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-teal-900 shadow-md backdrop-blur-md dark:bg-slate-900/90 dark:text-teal-300">
                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Atención Cálida & Fear Free
              </span>
              <span class="hidden sm:inline-block rounded-full bg-slate-900/80 px-2.5 py-0.5 text-[10px] font-semibold text-slate-200 backdrop-blur-xs">
                Pabellón & Urgencias
              </span>
            </div>
          </div>

          <!-- Métricas de impacto -->
          <div class="mt-5 grid grid-cols-2 gap-3.5 border-t border-slate-100 dark:border-slate-800/80 pt-5">
            <div class="rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-3.5 text-center transition">
              <p class="text-2xl sm:text-3xl font-extrabold text-teal-600 dark:text-teal-400">
                +5.000
              </p>
              <p class="mt-1 text-[11px] sm:text-xs font-semibold text-slate-600 dark:text-slate-300">
                Pacientes Atendidos
              </p>
            </div>
            <div class="rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-3.5 text-center transition">
              <p class="text-2xl sm:text-3xl font-extrabold text-teal-600 dark:text-teal-400">
                12+
              </p>
              <p class="mt-1 text-[11px] sm:text-xs font-semibold text-slate-600 dark:text-slate-300">
                Años de Trayectoria
              </p>
            </div>
            <div class="rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-3.5 text-center transition">
              <p class="text-2xl sm:text-3xl font-extrabold text-amber-500">24/7</p>
              <p class="mt-1 text-[11px] sm:text-xs font-semibold text-slate-600 dark:text-slate-300">
                Urgencias Médicas
              </p>
            </div>
            <div class="rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-3.5 text-center transition">
              <p class="text-2xl sm:text-3xl font-extrabold text-teal-600 dark:text-teal-400">
                100%
              </p>
              <p class="mt-1 text-[11px] sm:text-xs font-semibold text-slate-600 dark:text-slate-300">
                Médicos Colegiados
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
