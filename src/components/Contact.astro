---
// Componente de Contacto y Ubicación para la página principal
---

<section
  id="contacto"
  class="border-t border-slate-200/80 bg-slate-50/70 py-16 sm:py-24 dark:border-slate-800 dark:bg-slate-900/60"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Encabezado de la Sección -->
    <div class="text-center">
      <span class="inline-block rounded-full bg-teal-100 px-3.5 py-1 text-xs font-bold tracking-wider text-teal-800 uppercase dark:bg-teal-950/70 dark:text-teal-300">
        Atención & Ubicación
      </span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
        Canales de Contacto y Cómo Llegar
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-slate-600 sm:text-lg dark:text-slate-400">
        Encuéntranos en nuestra clínica central en Providencia o comunícate con nosotros por
        cualquiera de nuestros canales oficiales.
      </p>
    </div>

    <!-- Banner hacia el Portal de Agendamiento -->
    <div class="mt-10 overflow-hidden rounded-3xl bg-gradient-to-r from-teal-700 via-teal-600 to-emerald-600 p-6 text-white shadow-lg sm:p-8 dark:from-teal-800 dark:via-teal-700 dark:to-emerald-800">
      <div class="flex flex-col items-center justify-between gap-6 md:flex-row text-center md:text-left">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3 py-1 text-xs font-semibold text-white backdrop-blur-xs">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            Portal Exclusivo de Citas
          </span>
          <h3 class="mt-2 text-2xl font-black tracking-tight sm:text-3xl">
            ¿Deseas agendar una cita médica o servicio de spa?
          </h3>
          <p class="mt-2 max-w-xl text-sm text-teal-50">
            Elige tu especialidad, selecciona a tu veterinario de preferencia y reserva tu hora en
            tiempo real en nuestro portal de reservas.
          </p>
        </div>
        <a
          href="/agendar"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-2xl bg-white px-7 py-4 text-base font-bold text-teal-800 shadow-md transition hover:bg-teal-50 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-white active:scale-98 dark:bg-slate-100 dark:text-teal-950 dark:hover:bg-white"
        >
          Ir al Portal de Reserva de Horas
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>
        </a>
      </div>
    </div>

    <!-- Grid de Contacto y Ubicación en 2 Columnas balanceadas -->
    <div class="mt-12 grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12">
      <!-- Columna 1: Tarjetas de Información Directa (5 cols) -->
      <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-8 lg:col-span-5 dark:border-slate-800 dark:bg-slate-900">
        <div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white">Vías de Atención Directa</h3>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            Comunícate de forma inmediata con nuestro equipo clínico.
          </p>

          <div class="mt-6 space-y-5">
            <!-- Urgencias 24 Horas -->
            <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-4 dark:border-amber-900/60 dark:bg-amber-950/40">
              <div class="flex items-start gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-500 text-white shadow-2xs">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                    />
                  </svg>
                </span>
                <div>
                  <h4 class="text-xs font-bold text-amber-900 uppercase tracking-wider dark:text-amber-300">
                    Línea Prioritaria de Urgencias
                  </h4>
                  <a
                    href="tel:+56912345678"
                    class="text-lg font-black text-amber-800 hover:underline dark:text-amber-200"
                  >
                    +56 9 1234 5678
                  </a>
                  <p class="text-[11px] text-amber-900/80 mt-0.5 dark:text-amber-300/80">
                    Atención médica presencial ininterrumpida las 24 horas.
                  </p>
                </div>
              </div>
            </div>

            <!-- WhatsApp Oficial -->
            <div class="rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/40">
              <div class="flex items-start gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white shadow-2xs">
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z" />
                  </svg>
                </span>
                <div>
                  <h4 class="text-xs font-bold text-emerald-900 uppercase tracking-wider dark:text-emerald-300">
                    Mesa de Ayuda por WhatsApp
                  </h4>
                  <a
                    href="https://wa.me/56912345678?text=Hola,%20tengo%20una%20consulta%20para%20Veterinaria%20Huellitas"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-base font-bold text-emerald-700 hover:underline dark:text-emerald-300"
                  >
                    Iniciar Chat de Consulta
                  </a>
                  <p class="text-[11px] text-emerald-800/80 mt-0.5 dark:text-emerald-300/80">
                    Respuesta promedio en menos de 10 minutos.
                  </p>
                </div>
              </div>
            </div>

            <!-- Correo Oficial -->
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-800/60">
              <div class="flex items-start gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-600 text-white shadow-2xs">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    />
                  </svg>
                </span>
                <div>
                  <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider dark:text-slate-200">
                    Correo Electrónico
                  </h4>
                  <a
                    href="mailto:contacto@huellitasveterinaria.cl"
                    class="text-sm font-bold text-teal-700 hover:underline dark:text-teal-400"
                  >
                    contacto@huellitasveterinaria.cl
                  </a>
                  <p class="text-[11px] text-slate-500 mt-0.5 dark:text-slate-400">
                    Para presupuestos, convenios y trámites sanitarios.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-100 pt-4 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
          <p class="font-medium text-slate-700 dark:text-slate-300">
            Horario de Consultas Ambulatorias:
          </p>
          <p class="mt-0.5">
            Lunes a Viernes: 08:30 a 20:30 hrs · Fines de semana: 09:00 a 18:00 hrs.
          </p>
        </div>
      </div>

      <!-- Columna 2: Ubicación Física y Formulario de Mensaje Rápido (7 cols) -->
      <div class="flex flex-col justify-between space-y-6 rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-8 lg:col-span-7 dark:border-slate-800 dark:bg-slate-900">
        <!-- Tarjeta de Ubicación -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-5 dark:border-slate-800 dark:bg-slate-800/60">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-600 text-white shadow-2xs">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
            </span>
            <div>
              <h4 class="text-base font-bold text-slate-900 dark:text-white">
                Clínica Central Huellitas
              </h4>
              <p class="text-xs text-slate-600 dark:text-slate-300">
                Av. Principal de las Mascotas 1234, Providencia, Santiago
              </p>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
            <span class="inline-flex items-center gap-1 rounded-md bg-teal-50 px-2 py-1 text-teal-700 font-medium dark:bg-teal-950/80 dark:text-teal-300">
              🚗 Estacionamiento gratuito para clientes
            </span>
            <span class="inline-flex items-center gap-1 rounded-md bg-slate-200/70 px-2 py-1 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
              🚇 A 3 cuadras del Metro Los Leones
            </span>
          </div>
        </div>

        <!-- Formulario de Mensaje / Consulta General -->
        <div>
          <h4 class="text-lg font-bold text-slate-900 dark:text-white">
            ¿Tienes dudas o necesitas información?
          </h4>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            Envíanos un mensaje y te responderemos a la brevedad a tu correo o teléfono.
          </p>

          <form id="general-contact-form" class="mt-5 space-y-4" novalidate>
            <!-- Honeypot Antispam -->
            <div class="hidden" aria-hidden="true">
              <label for="contact-bot-field">Si eres humano deja este campo vacío</label>
              <input
                type="text"
                id="contact-bot-field"
                name="bot_security_check"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label
                  for="contact-name"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider dark:text-slate-300"
                >
                  Tu Nombre <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  minlength="3"
                  maxlength="100"
                  aria-describedby="error-contact-name"
                  placeholder="Tu nombre completo"
                  class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs placeholder:text-slate-400 focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-teal-400"
                />
                <p class="error-msg mt-1 hidden text-xs text-rose-600" id="error-contact-name">
                  Ingresa al menos 3 caracteres.
                </p>
              </div>

              <div>
                <label
                  for="contact-email"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider dark:text-slate-300"
                >
                  Correo Electrónico <span class="text-rose-500">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  maxlength="120"
                  aria-describedby="error-contact-email"
                  placeholder="ejemplo@correo.cl"
                  class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs placeholder:text-slate-400 focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-teal-400"
                />
                <p class="error-msg mt-1 hidden text-xs text-rose-600" id="error-contact-email">
                  Ingresa un correo válido.
                </p>
              </div>
            </div>

            <div>
              <label
                for="contact-message"
                class="block text-xs font-bold text-slate-700 uppercase tracking-wider dark:text-slate-300"
              >
                Mensaje o Consulta <span class="text-rose-500">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                required
                minlength="10"
                maxlength="1000"
                rows="3"
                aria-describedby="error-contact-message"
                placeholder="Escribe aquí tu duda, consulta sobre tratamientos o presupuestos..."
                class="mt-1.5 w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 shadow-2xs placeholder:text-slate-400 focus:border-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-teal-400"
              ></textarea>
              <p class="error-msg mt-1 hidden text-xs text-rose-600" id="error-contact-message">
                Escribe un mensaje de al menos 10 caracteres.
              </p>
            </div>

            <!-- Feedback de envío -->
            <div
              id="contact-feedback"
              class="hidden rounded-xl p-3.5 text-sm font-medium"
              role="status"
              aria-live="polite"
            ></div>

            <button
              type="submit"
              id="contact-submit-btn"
              class="inline-flex w-full items-center justify-center rounded-xl bg-teal-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-teal-700 focus-visible:outline-2 focus-visible:outline-teal-600 active:scale-98 disabled:opacity-60 dark:bg-teal-500 dark:text-slate-950 dark:hover:bg-teal-400"
            >
              <span id="contact-btn-text">Enviar Mensaje</span>
              <svg
                id="contact-btn-spinner"
                class="ml-2 hidden h-4 w-4 animate-spin text-white dark:text-slate-950"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"
                ></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('general-contact-form');
  const botField = document.getElementById('contact-bot-field');
  const submitBtn = document.getElementById('contact-submit-btn');
  const btnText = document.getElementById('contact-btn-text');
  const btnSpinner = document.getElementById('contact-btn-spinner');
  const feedback = document.getElementById('contact-feedback');

  function showMessage(type, text) {
    if (!feedback) return;
    feedback.classList.remove(
      'hidden',
      'bg-emerald-50',
      'text-emerald-800',
      'border',
      'border-emerald-200',
      'bg-rose-50',
      'text-rose-800',
      'border-rose-200'
    );

    if (type === 'success') {
      feedback.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
    } else {
      feedback.classList.add('bg-rose-50', 'text-rose-800', 'border', 'border-rose-200');
    }
    feedback.textContent = text;
  }

  function validate(input, errorId, checkFn) {
    const errorEl = document.getElementById(errorId);
    const valid = checkFn(input);
    if (!valid) {
      errorEl?.classList.remove('hidden');
      input?.classList.add('border-rose-400');
      input?.setAttribute('aria-invalid', 'true');
      return false;
    } else {
      errorEl?.classList.add('hidden');
      input?.classList.remove('border-rose-400');
      input?.setAttribute('aria-invalid', 'false');
      return true;
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Antispam Honeypot
    if (botField && botField.value.trim() !== '') {
      console.warn('Bot detected.');
      showMessage('success', '¡Gracias por tu mensaje! Te responderemos muy pronto.');
      form.reset();
      return;
    }

    const name = document.getElementById('contact-name');
    const email = document.getElementById('contact-email');
    const msg = document.getElementById('contact-message');

    const v1 = validate(name, 'error-contact-name', (el) => el.value.trim().length >= 3);
    const v2 = validate(email, 'error-contact-email', (el) =>
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim())
    );
    const v3 = validate(msg, 'error-contact-message', (el) => el.value.trim().length >= 10);

    if (!v1 || !v2 || !v3) {
      showMessage('error', 'Por favor completa todos los campos requeridos correctamente.');
      return;
    }

    if (submitBtn && btnText && btnSpinner) {
      submitBtn.setAttribute('disabled', 'true');
      btnText.textContent = 'Enviando...';
      btnSpinner.classList.remove('hidden');
    }

    try {
      await new Promise((resolve) => setTimeout(resolve, 900));
      showMessage(
        'success',
        '¡Mensaje recibido con éxito! Te responderemos a la brevedad posible.'
      );
      form.reset();
      [name, email, msg].forEach((el) => el?.removeAttribute('aria-invalid'));
    } catch {
      showMessage(
        'error',
        'Ocurrió un error. Escríbenos directamente a contacto@huellitasveterinaria.cl.'
      );
    } finally {
      if (submitBtn && btnText && btnSpinner) {
        submitBtn.removeAttribute('disabled');
        btnText.textContent = 'Enviar Mensaje';
        btnSpinner.classList.add('hidden');
      }
    }
  });
</script>
