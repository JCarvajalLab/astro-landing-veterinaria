---
import { Image } from 'astro:assets';
import draValentinaImg from '../assets/team/dra-valentina.jpg';
import drCarlosImg from '../assets/team/dr-carlos.jpg';
import draCamilaImg from '../assets/team/dra-camila.jpg';
import rodrigoLagosImg from '../assets/team/rodrigo-lagos.jpg';

const team = [
  {
    name: 'Dra. Valentina Muñoz',
    role: 'Directora Médica & Cirugía General',
    experience: '14 años de experiencia',
    bio: 'Especialista en cirugía de tejidos blandos y manejo del paciente crítico. Apasionada por devolver la vitalidad a cada mascota.',
    image: draValentinaImg,
  },
  {
    name: 'Dr. Carlos Valenzuela',
    role: 'Especialista en Medicina Felina & Diagnóstico',
    experience: '9 años de experiencia',
    bio: 'Certificado en manejo Cat Friendly. Experto en ecografía abdominal y medicina interna para felinos y canes de edad avanzada.',
    image: drCarlosImg,
  },
  {
    name: 'Dra. Camila Soto',
    role: 'Medicina Preventiva & Dermatología',
    experience: '7 años de experiencia',
    bio: 'Dedicada al tratamiento de alergias cutáneas, nutrición clínica personalizada y esquemas de vacunación sin trauma.',
    image: draCamilaImg,
  },
  {
    name: 'Rodrigo Lagos',
    role: 'Técnico Veterinario Jefe & Spa',
    experience: '6 años de experiencia',
    bio: 'Líder en cuidados hospitalarios y cosmetología canina con enfoque libre de estrés (Fear Free Certified).',
    image: rodrigoLagosImg,
  },
];
---

<section id="nosotros" class="border-t border-slate-200/80 bg-slate-50 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="inline-block rounded-full bg-teal-100 px-3.5 py-1 text-xs font-bold tracking-wider text-teal-800 uppercase">
        Vocación Médica & Compromiso
      </span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        Conoce a los especialistas detrás de cada sonrisa
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-slate-600 sm:text-lg">
        Un equipo humano multidisciplinario comprometido con la salud, la dignidad y el bienestar de
        los animales.
      </p>
    </div>

    <!-- Grid de profesionales -->
    <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {team.map((member) => (
        <article class="flex flex-col justify-between rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs transition hover:-translate-y-1 hover:border-teal-300 hover:shadow-lg">
          <div>
            <!-- Retrato con astro:assets -->
            <div class="relative mx-auto h-32 w-32 overflow-hidden rounded-2xl shadow-md ring-4 ring-teal-50">
              <Image
                src={member.image}
                alt={`Retrato profesional de ${member.name}`}
                width={256}
                height={256}
                class="h-full w-full object-cover object-top"
                loading="lazy"
              />
            </div>

            <!-- Datos principales -->
            <div class="mt-5 text-center">
              <h3 class="text-lg font-bold text-slate-900">{member.name}</h3>
              <p class="mt-1 text-xs font-semibold text-teal-700">{member.role}</p>
              <span class="mt-2 inline-block rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-600">
                {member.experience}
              </span>
            </div>

            <!-- Reseña del profesional -->
            <p class="mt-4 text-xs leading-relaxed text-slate-600 text-center">{member.bio}</p>
          </div>

          <!-- Distintivo colegiado -->
          <div class="mt-6 border-t border-slate-100 pt-4 text-center">
            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500">
              <svg
                class="h-4 w-4 text-teal-600"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                />
              </svg>
              Médico Veterinario Certificado
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
