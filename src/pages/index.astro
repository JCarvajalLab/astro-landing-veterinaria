  <!-- Sección Equipo Médico Veterinario -->
  <Team />

  <!-- Sección Testimonios y Familias -->
  <Testimonials />

  <!-- Sección Horarios y Urgencias -->
  <Schedule />

  <!-- Sección Preguntas Frecuentes -->
  <Faq />

  <!-- Sección de Contacto y Agendamiento (Fase 4) -->
  <ContactForm />
</Layout>
