---
// src/components/BookingModal.astro
// Modal de advertencia para prevenir la pérdida del progreso al intentar salir de /agendar
---

<div
  id="leave-booking-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 transition-all duration-300 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="leave-modal-title"
  aria-describedby="leave-modal-desc"
>
  <!-- Backdrop con desenfoque de fondo -->
  <div
    id="leave-modal-backdrop"
    class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity"
  ></div>

  <!-- Contenedor del Modal -->
  <div
    class="relative w-full max-w-lg transform overflow-hidden rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 text-left shadow-2xl transition-all scale-95"
    id="leave-modal-panel"
  >
    <!-- Botón cerrar (X) -->
    <button
      type="button"
      id="btn-close-leave-modal"
      class="absolute top-5 right-5 inline-flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-slate-500 hover:bg-slate-200 hover:text-slate-800 transition focus-visible:outline-2 focus-visible:outline-teal-600"
      aria-label="Cerrar ventana"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        />
      </svg>
    </button>

    <!-- Encabezado con Icono de Advertencia Amigable -->
    <div class="flex items-center gap-3.5">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 shadow-xs">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          />
        </svg>
      </span>
      <div>
        <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-800 uppercase tracking-wider">
          Reserva en Curso
        </span>
        <h3 id="leave-modal-title" class="text-xl font-extrabold text-slate-900 mt-0.5">
          ¿Deseas salir del agendamiento?
        </h3>
      </div>
    </div>

    <!-- Contenido y Pregunta -->
    <div class="mt-4">
      <p id="leave-modal-desc" class="text-base font-bold text-slate-900">
        Tienes una reserva de hora médica iniciada.
      </p>
      <p class="mt-2 text-xs text-slate-600 leading-relaxed">
        Si sales ahora hacia la página principal u otra sección de la web,{' '}
        <strong>se perderá el progreso de tu reserva</strong> (especialidad seleccionada,
        profesional asignado y horario elegido).
      </p>

      <div class="mt-4 rounded-2xl border border-teal-200 bg-teal-50/70 p-3.5 text-xs text-teal-900">
        <div class="flex items-center gap-2">
          <span class="text-base shrink-0">💡</span>
          <p class="text-[11px] font-semibold text-teal-950">
            Solo toma 1 minuto completar los datos de tu mascota y obtener tu comprobante con código
            QR.
          </p>
        </div>
      </div>
    </div>

    <!-- Acciones del Modal -->
    <div class="mt-6 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3 border-t border-slate-100 pt-5">
      <button
        type="button"
        id="btn-confirm-leave"
        class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-xs font-bold text-slate-600 shadow-2xs hover:bg-slate-100 hover:text-slate-900 transition focus-visible:outline-2 focus-visible:outline-teal-600 active:scale-98"
      >
        Salir y Perder Progreso
      </button>
      <button
        type="button"
        id="btn-stay-booking"
        class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-teal-600 px-6 py-2.5 text-xs font-bold text-white shadow-md hover:bg-teal-700 transition focus-visible:outline-2 focus-visible:outline-teal-600 active:scale-98"
      >
        Continuar con mi Reserva →
      </button>
    </div>
  </div>
</div>

<script>
  // Control de alerta de abandono de reserva (solo activo en /agendar)
  const isBookingPage =
    window.location.pathname === '/agendar' || window.location.pathname === '/agendar/';

  if (isBookingPage) {
    const modal = document.getElementById('leave-booking-modal');
    const modalPanel = document.getElementById('leave-modal-panel');
    const btnClose = document.getElementById('btn-close-leave-modal');
    const btnStay = document.getElementById('btn-stay-booking');
    const btnLeave = document.getElementById('btn-confirm-leave');
    const backdrop = document.getElementById('leave-modal-backdrop');

    let targetUrl = '';

    function openLeaveModal(destinationUrl) {
      if (!modal || !modalPanel) return;
      targetUrl = destinationUrl;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      modalPanel.classList.remove('scale-95');
      modalPanel.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
      btnStay?.focus();
    }

    function closeLeaveModal() {
      if (!modal || !modalPanel) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
      modalPanel.classList.add('scale-95');
      modalPanel.classList.remove('scale-100');
      document.body.style.overflow = '';
      targetUrl = '';
    }

    function hasActiveBooking() {
      // Si ya está en confirmación final (Paso 4), no se interrumpe
      const step4 = document.getElementById('step-4');
      if (step4 && !step4.classList.contains('hidden')) {
        return false;
      }

      // Si ya avanzó al Paso 2 o 3, o si el formulario tiene datos
      const step2 = document.getElementById('step-2');
      const step3 = document.getElementById('step-3');
      const isPastStep1 =
        (step2 && !step2.classList.contains('hidden')) ||
        (step3 && !step3.classList.contains('hidden'));

      // O si seleccionó un área y tiene intención de reserva activa
      return isPastStep1;
    }

    // Interceptar clics en enlaces salientes (Navbar, logo, volver, footer)
    document.addEventListener('click', (e) => {
      const target = e.target;
      const link =
        target && typeof target.closest === 'function' ? target.closest('a[href]') : null;

      if (!link) return;

      const href = link.getAttribute('href') || '';

      // Si es un enlace dentro de la misma página que no sea salir (o javascript:void)
      if (href.startsWith('#') || href.startsWith('javascript:')) return;

      // Si es una salida hacia la landing (/#servicios, /#contacto, /index, /)
      const isLeaving =
        href === '/' ||
        href.startsWith('/#') ||
        href.startsWith('http') ||
        href.includes('contacto') ||
        href.includes('servicios');

      if (isLeaving && hasActiveBooking()) {
        e.preventDefault();
        openLeaveModal(link.href);
      }
    });

    btnStay?.addEventListener('click', closeLeaveModal);
    btnClose?.addEventListener('click', closeLeaveModal);
    backdrop?.addEventListener('click', closeLeaveModal);

    btnLeave?.addEventListener('click', () => {
      if (targetUrl) {
        window.location.href = targetUrl;
      } else {
        closeLeaveModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
        closeLeaveModal();
      }
    });
  }
</script>
