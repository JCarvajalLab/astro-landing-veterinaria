---
const testimonials = [
  {
    author: 'Marcela Contreras',
    pet: 'Simón (Golden Retriever, 4 años)',
    rating: 5,
    title: '¡Le salvaron la vida a nuestro Simón un domingo a las 3 AM!',
    comment:
      'Llegamos de urgencia con una torsión gástrica crítica en plena madrugada. El equipo médico actuó en minutos con una calidez y profesionalismo que nunca olvidaremos. Hoy Simón corre y juega como siempre.',
    tag: 'Urgencia 24/7',
  },
  {
    author: 'Felipe Henríquez',
    pet: 'Luna (Gata Siamesa, 2 años)',
    rating: 5,
    title: 'El mejor trato Fear Free para gatos que he conocido',
    comment:
      'Luna siempre se estresaba al extremo en las veterinarias. En Huellitas el Dr. Carlos usó feromonas y técnicas amigables que hicieron que su esterilización y vacunas fueran una experiencia tranquila.',
    tag: 'Medicina Felina',
  },
  {
    author: 'Constanza Morales',
    pet: 'Rocky (Bulldog Francés, 5 años)',
    rating: 5,
    title: 'Controlaron sus alergias después de meses de frustración',
    comment:
      'Rocky sufría de dermatitis severa y otitis recurrente. La Dra. Camila le diseñó una dieta especial y tratamiento dérmico que le devolvió la salud a su piel en menos de un mes. Totalmente recomendados.',
    tag: 'Dermatología',
  },
];
---

<section id="testimonios" class="border-t border-slate-200/80 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="inline-block rounded-full bg-teal-100 px-3 py-1 text-xs font-bold tracking-wider text-teal-800 uppercase">
        Historias Reales
      </span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        Familias felices, mascotas sanas y protegidas
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-slate-600 sm:text-lg">
        La confianza de quienes nos entregan la salud de sus seres más queridos es nuestro mayor
        orgullo.
      </p>

      <!-- Badge de calificación global -->
      <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 shadow-xs">
        <div class="flex text-amber-400" aria-label="Calificación 5 de 5 estrellas">
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-sm font-bold text-slate-800">4.9 / 5.0</span>
        <span class="text-xs text-slate-500">en más de 850 opiniones verificadas</span>
      </div>
    </div>

    <!-- Grid de testimonios -->
    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
      {testimonials.map((item) => (
        <article class="flex flex-col justify-between rounded-2xl border border-slate-200/80 bg-slate-50/70 p-6 shadow-xs transition hover:border-teal-300 hover:bg-white hover:shadow-lg">
          <div>
            <!-- Estrellas y Tag -->
            <div class="flex items-center justify-between">
              <div class="flex text-amber-400" aria-label={`${item.rating} de 5 estrellas`}>
                {Array.from({ length: item.rating }).map(() => (
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <span class="rounded-full bg-teal-100/80 px-2.5 py-0.5 text-xs font-semibold text-teal-800">
                {item.tag}
              </span>
            </div>

            <!-- Título del testimonio -->
            <h3 class="mt-4 text-base font-bold text-slate-900 leading-snug">“{item.title}”</h3>

            <!-- Comentario -->
            <p class="mt-3 text-sm leading-relaxed text-slate-600 italic">{item.comment}</p>
          </div>

          <!-- Autor y Mascota -->
          <div class="mt-6 flex items-center gap-3 border-t border-slate-200/60 pt-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-teal-600 text-sm font-bold text-white">
              {item.author.charAt(0)}
            </div>
            <div>
              <p class="text-sm font-bold text-slate-900">{item.author}</p>
              <p class="text-xs text-slate-500">Tutor de {item.pet}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
