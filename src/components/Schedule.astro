---
const weeklyHours = [
  {
    service: 'Consultas Médicas & Especialidades',
    days: 'Lunes a Viernes',
    hours: '08:30 – 20:30 hrs',
    status: 'Por orden de llegada y cita',
    icon: 'stethoscope',
  },
  {
    service: 'Exámenes & Laboratorio Clínico',
    days: 'Lunes a Sábado',
    hours: '08:30 – 19:00 hrs',
    status: 'Toma de muestras matutina',
    icon: 'flask',
  },
  {
    service: 'Peluquería Canina & Spa',
    days: 'Lunes a Sábado',
    hours: '09:00 – 18:00 hrs',
    status: 'Con reserva previa',
    icon: 'scissors',
  },
  {
    service: 'Atención Fin de Semana',
    days: 'Sábado y Domingo',
    hours: 'Sáb: 09:00–18:00 · Dom: 10:00–15:00',
    status: 'Medicina general y control',
    icon: 'calendar',
  },
];
---

<section id="horarios" class="border-t border-slate-200/80 bg-slate-50/70 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Encabezado de Sección -->
    <div class="text-center">
      <span class="inline-block rounded-full bg-teal-100 px-3.5 py-1 text-xs font-bold tracking-wider text-teal-800 uppercase">
        Atención & Disponibilidad
      </span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        Horarios pensados para tu tranquilidad
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-slate-600 sm:text-lg">
        Atención programada durante toda la semana y guardia médica permanente para cualquier
        imprevisto de tu mascota.
      </p>
    </div>

    <!-- Contenedor Principal en 2 Columnas Asimétricas -->
    <div class="mt-12 grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12">
      <!-- Columna Izquierda: Agenda Semanal Regular (7 cols) -->
      <div class="flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-white p-6 shadow-sm sm:p-8 lg:col-span-7">
        <div>
          <div class="flex items-center justify-between border-b border-slate-100 pb-5">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50 text-teal-700">
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              </span>
              <div>
                <h3 class="text-lg font-bold text-slate-900">Agenda Semanal de Atención</h3>
                <p class="text-xs text-slate-500">Servicios clínicos y estética ambulatoria</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Abierto Hoy
            </span>
          </div>

          <!-- Lista estilizada de horarios -->
          <div class="mt-6 divide-y divide-slate-100">
            {weeklyHours.map((item) => (
              <div class="flex flex-col justify-between gap-2 py-4 sm:flex-row sm:items-center">
                <div class="flex items-start gap-3">
                  <div class="mt-0.5 text-teal-600">
                    {item.icon === 'stethoscope' && (
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                        />
                      </svg>
                    )}
                    {item.icon === 'flask' && (
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                        />
                      </svg>
                    )}
                    {item.icon === 'scissors' && (
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242L10.757 10.757m0 0L7.879 7.879a3 3 0 10-4.242 4.242L6.515 15m4.242-4.242L15 6.515"
                        />
                      </svg>
                    )}
                    {item.icon === 'calendar' && (
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        />
                      </svg>
                    )}
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-slate-900">{item.service}</p>
                    <p class="text-xs text-slate-500">
                      {item.days} · <span class="text-teal-700 font-medium">{item.status}</span>
                    </p>
                  </div>
                </div>

                <div class="sm:text-right">
                  <span class="inline-block rounded-lg bg-slate-100 px-3 py-1 font-mono text-xs font-bold tracking-tight text-slate-800">
                    {item.hours}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 border-t border-slate-100 pt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between text-xs text-slate-500 gap-2">
          <span>📍 Av. Principal de las Mascotas 1234, Santiago</span>
          <a href="#contacto" class="font-semibold text-teal-700 hover:text-teal-800 transition">
            Agendar cita en línea →
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Urgencias Médicas 24/7 (5 cols) -->
      <div class="relative flex flex-col justify-between overflow-hidden rounded-3xl bg-slate-900 p-6 text-white shadow-xl sm:p-8 lg:col-span-5">
        <!-- Resplandor decorativo de fondo -->
        <div class="pointer-events-none absolute -top-12 -right-12 h-48 w-48 rounded-full bg-teal-500/20 blur-2xl"></div>

        <div>
          <!-- Badge de guardia activa -->
          <div class="inline-flex items-center gap-2 rounded-full border border-teal-500/40 bg-teal-950/70 px-3 py-1 text-xs font-semibold text-teal-300">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-400"></span>
            </span>
            Pabellón y Guardia Médica Activa
          </div>

          <h3 class="mt-4 text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
            Urgencias Veterinarias 24/7
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">
            Los accidentes e imprevistos de salud ocurren en cualquier momento. Nuestro hospital
            nunca duerme.
          </p>

          <!-- Qué incluye la urgencia -->
          <ul class="mt-6 space-y-2.5 text-xs text-slate-300">
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-teal-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>Médico cirujano y enfermeros veterinarios de turno presencial</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-teal-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>Oxigenoterapia, monitoreo intensivo y fluidoterapia</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-teal-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>Laboratorio de urgencia y ecografía en minutos</span>
            </li>
          </ul>
        </div>

        <!-- Botón de Llamada Rápida a Urgencias -->
        <div class="mt-8 border-t border-slate-800 pt-6">
          <p class="text-xs text-slate-400">
            ¿Vienes en camino? Llámanos para preparar el box clínico:
          </p>
          <a
            href="tel:+56912345678"
            class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-teal-500 px-5 py-3.5 text-center text-sm font-bold text-slate-950 shadow-lg transition hover:bg-teal-400 focus-visible:outline-2 focus-visible:outline-teal-400 active:scale-98"
          >
            <svg
              class="h-5 w-5 text-slate-950"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              />
            </svg>
            Línea Urgencias: +56 9 1234 5678
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
