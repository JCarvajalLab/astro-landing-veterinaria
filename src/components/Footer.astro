---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <!-- Columna 1: Marca y Misión -->
      <div class="space-y-4">
        <div class="flex items-center gap-2 text-xl font-bold text-white">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-teal-600 text-white shadow-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <circle cx="12" cy="15" r="4" />
              <circle cx="6.5" cy="11.5" r="2" />
              <circle cx="10" cy="7.5" r="2" />
              <circle cx="14" cy="7.5" r="2" />
              <circle cx="17.5" cy="11.5" r="2" />
            </svg>
          </span>
          <span>
            Huellitas<span class="text-teal-400">.</span>
          </span>
        </div>
        <p class="text-sm leading-relaxed text-slate-400">
          Clínica veterinaria integral dedicada al cuidado preventivo, diagnóstico y bienestar
          amoroso de perros y gatos.
        </p>
        <div class="inline-flex items-center gap-2 rounded-md bg-teal-950/60 border border-teal-800/60 px-3 py-1.5 text-xs font-semibold text-teal-300">
          <span class="h-2 w-2 rounded-full bg-teal-400 animate-pulse" aria-hidden="true"></span>
          Servicio de Urgencias 24 Horas
        </div>
      </div>

      <!-- Columna 2: Enlaces Rápidos -->
      <div>
        <h2 class="text-sm font-semibold tracking-wider text-white uppercase">Navegación</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a
              href="#servicios"
              class="transition hover:text-teal-400 focus-visible:outline-2 focus-visible:outline-teal-400"
            >
              Servicios Clínicos
            </a>
          </li>
          <li>
            <a
              href="#nosotros"
              class="transition hover:text-teal-400 focus-visible:outline-2 focus-visible:outline-teal-400"
            >
              Nuestro Equipo Médico
            </a>
          </li>
          <li>
            <a
              href="#testimonios"
              class="transition hover:text-teal-400 focus-visible:outline-2 focus-visible:outline-teal-400"
            >
              Familias Felices
            </a>
          </li>
          <li>
            <a
              href="#horarios"
              class="transition hover:text-teal-400 focus-visible:outline-2 focus-visible:outline-teal-400"
            >
              Horarios y Ubicación
            </a>
          </li>
          <li>
            <a
              href="#contacto"
              class="transition hover:text-teal-400 focus-visible:outline-2 focus-visible:outline-teal-400"
            >
              Agendar Hora
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Servicios destacados -->
      <div>
        <h2 class="text-sm font-semibold tracking-wider text-white uppercase">Servicios</h2>
        <ul class="mt-4 space-y-2.5 text-sm text-slate-400">
          <li>Medicina preventiva y vacunas</li>
          <li>Cirugía general y de tejidos blandos</li>
          <li>Odontología y limpieza ultrasónica</li>
          <li>Peluquería canina y spa felino</li>
          <li>Laboratorio clínico y ecografías</li>
        </ul>
      </div>

      <!-- Columna 4: Contacto directo -->
      <div>
        <h2 class="text-sm font-semibold tracking-wider text-white uppercase">
          Contacto & Urgencias
        </h2>
        <ul class="mt-4 space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-2.5">
            <svg
              class="h-5 w-5 shrink-0 text-teal-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>
            <span>Av. Principal de las Mascotas 1234, Santiago, Chile</span>
          </li>
          <li class="flex items-center gap-2.5">
            <svg
              class="h-5 w-5 shrink-0 text-teal-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              />
            </svg>
            <a
              href="tel:+56912345678"
              class="transition hover:text-white focus-visible:outline-2 focus-visible:outline-teal-400"
            >
              +56 9 1234 5678
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg
              class="h-5 w-5 shrink-0 text-teal-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>
            <a
              href="mailto:contacto@huellitasveterinaria.cl"
              class="transition hover:text-white focus-visible:outline-2 focus-visible:outline-teal-400"
            >
              contacto@huellitasveterinaria.cl
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior de copyright -->
    <div class="mt-12 border-t border-slate-800 pt-8 sm:flex sm:items-center sm:justify-between text-xs text-slate-500">
      <p>© {currentYear} Veterinaria Huellitas. Todos los derechos reservados.</p>
      <div class="mt-4 flex space-x-6 sm:mt-0">
        <a href="#contacto" class="hover:text-slate-400 transition">
          Aviso Legal
        </a>
        <a href="#contacto" class="hover:text-slate-400 transition">
          Política de Privacidad
        </a>
        <a href="#contacto" class="hover:text-slate-400 transition">
          Términos de Servicio
        </a>
      </div>
    </div>
  </div>
</footer>
